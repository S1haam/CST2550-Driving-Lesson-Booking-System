@page "/faqs"
@rendermode InteractiveServer
@inject NavigationManager Nav

<h3>FAQs</h3>

<!-- nav bar -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card faq-card">

    <h1>Frequently Asked Questions</h1>

    <div class="faq-box">

        <!-- faq item -->
        <div class="faq-item" @onclick='() => Toggle(0)'>
            <div class="faq-header">
                <span>Is there a cancellation fee for lessons?</span>
                <span>@(openIndex == 0 ? "−" : "+")</span>
            </div>

            @if (openIndex == 0)
            {
                <div class="faq-answer">
                    If the student contacts their instructor 72 hours prior to their lesson, there is no fee.
                </div>
            }
        </div>

        <div class="faq-item" @onclick='() => Toggle(1)'>
            <div class="faq-header">
                <span>Can I call to schedule appointments?</span>
                <span>@(openIndex == 1 ? "−" : "+")</span>
            </div>

            @if (openIndex == 1)
            {
                <div class="faq-answer">
                    No, we operate based on online bookings.
                </div>
            }
        </div>

        <div class="faq-item" @onclick='() => Toggle(2)'>
            <div class="faq-header">
                <span>Am I limited to just one lesson a week?</span>
                <span>@(openIndex == 2 ? "−" : "+")</span>
            </div>

            @if (openIndex == 2)
            {
                <div class="faq-answer">
                    No, provided the student can pay before their appointment, they can have several lessons in a week.
                </div>
            }
        </div>

    </div>

</div>

@code {
    int openIndex = -1;

    // toggles open/close
    void Toggle(int index)
    {
        if (openIndex == index)
            openIndex = -1;
        else
            openIndex = index;
    }
}