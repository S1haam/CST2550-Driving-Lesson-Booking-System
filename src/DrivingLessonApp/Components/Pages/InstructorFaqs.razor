@page "/instructor-faqs"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Instructor FAQs</h3>

<!-- NAV BAR -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<!-- FAQ CARD -->
<div class="booking-card instructor-faq-card">

    <h1 class="faq-title">Frequently Asked Questions</h1>

    <div class="instructor-faq-list">

        @foreach (var faq in faqs)
        {
            <div class="instructor-faq-item" @onclick="() => ToggleFaq(faq)">

                <div class="instructor-faq-header">
                    <span>@faq.Question</span>
                    <span>@(faq.IsOpen ? "−" : "+")</span>
                </div>

                @if (faq.IsOpen)
                {
                    <div class="instructor-faq-answer">
                        @faq.Answer
                    </div>
                }

            </div>
        }

    </div>

</div>

@code {
    class FaqItem
    {
        public string Question { get; set; }
        public string Answer { get; set; }
        public bool IsOpen { get; set; }
    }

    List<FaqItem> faqs = new()
    {
        new() {
            Question = "How do I manage my lesson schedule?",
            Answer = "Go to 'My Schedule' where you can view, update, or cancel upcoming lessons."
        },
        new() {
            Question = "How do I respond to booking requests?",
            Answer = "All booking requests will appear in your Inbox. You can accept or decline them there."
        },
        new() {
            Question = "Can I reschedule a lesson?",
            Answer = "Yes, you can reschedule lessons from your schedule page or via notifications in your Inbox."
        },
        new() {
            Question = "How do I remove a student?",
            Answer = "Go to your student list and select the student you want to remove."
        },
        new() {
            Question = "How do I update my account settings?",
            Answer = "Navigate to Settings where you can update your password and preferences."
        }
    };

    void ToggleFaq(FaqItem faq)
    {
        faq.IsOpen = !faq.IsOpen;
    }
}