@page "/"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Hello X!</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<!-- next lesson -->
<div class="outer-card">

    <div class="section-label">Next Lesson</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>12340586</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>David</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>15/08/2025</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>12:00-14:00</strong>
            </div>

            <button class="action-btn"
                    @onclick='() => Nav.NavigateTo("/schedule?tab=next")'>
                View All
            </button>

        </div>
    </div>
</div>

<!-- previous lesson -->
<div class="outer-card secondary">

    <div class="section-label">Previous Lesson</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>12342386</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>David</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>02/08/2025</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>13:00-15:00</strong>
            </div>

            <button class="action-btn"
                    @onclick='() => Nav.NavigateTo("/schedule?tab=previous")'>
                View All
            </button>

        </div>
    </div>
</div>