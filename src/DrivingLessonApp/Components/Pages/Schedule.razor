@page "/schedule"
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>My Schedule</h3>

<!-- nav bar -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<div class="card next-card">

    <!-- top section -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">

        <!-- tabs -->
        <div class="tabs">
            <div class="tab @(showNext ? "active" : "")"
                 @onclick='() => showNext = true'>
                Next Lessons
            </div>

            <div class="tab @(!showNext ? "active" : "")"
                 @onclick='() => showNext = false'>
                Previous Lessons
            </div>
        </div>

        <!-- search -->
        <div class="search-container">
            <input @bind="searchId" placeholder="Search by ID" />
            <button @onclick="SearchBooking">Search</button>
        </div>

    </div>

    <!-- results -->
    <div class="lesson-list">

        @if (searchResult != null)
        {
            <div class="lesson-item">
                <span>@searchResult.Date @searchResult.Time</span>
                <button @onclick='() => Nav.NavigateTo("/lesson-details")'>VIEW</button>
            </div>
        }
        else if (showNext)
        {
            @foreach (var lesson in nextLessons)
            {
                <div class="lesson-item">
                    <span>@lesson.Date @lesson.Time</span>
                    <div>
                        <button>VIEW</button>
                        <button>RESCHEDULE</button>
                        <button>CANCEL</button>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach (var lesson in previousLessons)
            {
                <div class="lesson-item">
                    <span>@lesson.Date @lesson.Time</span>
                    <button @onclick='() => Nav.NavigateTo("/lesson-details")'>VIEW</button>
                </div>
            }
        }

    </div>

</div>

                        @code {
    bool showNext = true;
    string searchId;
    Lesson searchResult;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tab))
        {
            showNext = tab == "next";
        }
    }

    List<Lesson> nextLessons = new()
    {
        new Lesson { Id = 12340586, Date = "15/08/2025", Time = "12:00-14:00" },
        new Lesson { Id = 12340587, Date = "17/08/2025", Time = "15:00-18:00" }
    };

    List<Lesson> previousLessons = new()
    {
        new Lesson { Id = 12342386, Date = "02/08/2025", Time = "13:00-15:00" }
    };

    void SearchBooking()
    {
        searchResult = null;

        foreach (var lesson in nextLessons)
        {
            if (lesson.Id.ToString() == searchId)
            {
                searchResult = lesson;
                return;
            }
        }

        foreach (var lesson in previousLessons)
        {
            if (lesson.Id.ToString() == searchId)
            {
                searchResult = lesson;
                return;
            }
        }
    }

    class Lesson
    {
        public int Id { get; set; }
        public string Date { get; set; }
        public string Time { get; set; }
    }
}