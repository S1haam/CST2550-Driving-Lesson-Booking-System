@page "/schedule"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>My Schedule</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<div class="card next-card">

    <div class="tabs">
        <div class="tab @(showNext ? "active" : "")"
             @onclick='() => showNext = true'>
            Next Lessons
        </div>

        <div class="tab @(!showNext ? "active" : "")"
             @onclick='() => showNext = false'>
            Previous Lessons
        </div>
    </div>

    <div class="lesson-list">

        @if (showNext)
        {
            <div class="lesson-item">
                <span>15/08/2025 12:00-14:00</span>
                <div>
                    <button>VIEW</button>
                    <button>RESCHEDULE</button>
                    <button>CANCEL</button>
                </div>
            </div>

            <div class="lesson-item">
                <span>17/08/2025 15:00-18:00</span>
                <div>
                    <button>VIEW</button>
                    <button>RESCHEDULE</button>
                    <button>CANCEL</button>
                </div>
            </div>
        }
        else
        {
            <div class="lesson-item">
                <span>02/08/2025 13:00-15:00</span>
                <div>
                    <button @onclick='() => Nav.NavigateTo("/lesson-details")'>VIEW</button>
                </div>
            </div>
        }

    </div>

</div>

@code {
    bool showNext = true;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (uri.Query.Contains("previous"))
            showNext = false;
    }
}