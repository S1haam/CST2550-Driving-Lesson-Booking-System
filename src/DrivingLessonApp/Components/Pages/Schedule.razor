@page "/schedule"

<h3>My Schedule</h3>

<!-- navigation bar for switching between pages -->
<div class="nav-bar">
    <button>Home</button>
    <button>My Schedule</button>
    <button>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<div class="card">

    <!-- tabs to switch between next and previous lessons -->
    <div class="tabs">
        <div class="tab active">Next Lessons:</div>
        <div class="tab">Previous Lessons:</div>
    </div>

    <!-- container that holds lessons and allows scrolling -->
    <div class="lesson-list">

        <!-- single lesson item showing date and time -->
        <div class="lesson-item">
            <span>15/08/2025 12:00-14:00</span>

            <!-- buttons for user actions -->
            <div class="lesson-actions">
                <button>VIEW</button>
                <button>RESCHEDULE</button>
                <button>CANCEL</button>
            </div>
        </div>

        <!-- additional lesson item -->
        <div class="lesson-item">
            <span>17/08/2025 15:00-18:00</span>
            <div class="lesson-actions">
                <button>VIEW</button>
                <button>RESCHEDULE</button>
                <button>CANCEL</button>
            </div>
        </div>

        <!-- additional lesson item -->
        <div class="lesson-item">
            <span>19/08/2025 11:00-12:00</span>
            <div class="lesson-actions">
                <button>VIEW</button>
                <button>RESCHEDULE</button>
                <button>CANCEL</button>
            </div>
        </div>

    </div>

</div>