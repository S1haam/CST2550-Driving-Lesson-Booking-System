    </button>

    <!-- admin -->
    <button class="booking-btn" @onclick='() => Nav.NavigateTo("/signup-admin")'>
        Admin
    </button>

<button class="start-secondary-btn" @onclick='() => Nav.NavigateTo("/login")'>
    Next
</button>

</div>