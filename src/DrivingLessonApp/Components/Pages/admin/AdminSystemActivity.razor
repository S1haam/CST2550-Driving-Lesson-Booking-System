@page "/admin/system-activity"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="admin-main-content admin-system-activity-page admin-detail-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">System Activity</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading system activity...</p>
    }
    else
    {
        <div class="admin-outer-card">
            <div class="admin-inner-card">
                <div class="admin-detail-panel">
                    <div class="admin-detail-grid">

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Activity Overview</div>
                            <p><strong>Total Students:</strong> @Overview.TotalStudents</p>
                            <p><strong>Active This Week:</strong> @Overview.ActiveThisWeek</p>
                            <p><strong>Inactive Over 100 Days:</strong> @Overview.InactiveStudents</p>
                            <p><strong>Lessons Booked This Week:</strong> @Overview.WeeklyBookings</p>
                        </div>

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Quick Actions</div>

                            <div class="admin-meta-row">
                                <button class="admin-mini-card action-card" type="button"
                                        @onclick='() => Nav.NavigateTo("/admin/remove-students")'>
                                    <span>Inactive Students</span>
                                    <strong>Manage Removals</strong>
                                </button>

                                <button class="admin-mini-card action-card" type="button"
                                        @onclick='() => Nav.NavigateTo("/admin/students")'>
                                    <span>Student Records</span>
                                    <strong>Open Student Database</strong>
                                </button>
                            </div>
                        </div>

                        <div class="admin-detail-box admin-detail-box-wide">
                            <div class="admin-section-label">Recent Student Activity</div>

                            <div class="admin-activity-table-wrap">
                                <table class="admin-activity-table">
                                    <thead>
                                        <tr>
                                            <th>Student ID</th>
                                            <th>Name</th>
                                            <th>Last Activity</th>
                                            <th>Status</th>
                                            <th>View</th>
                                        </tr>
                                    </thead>

                                    <tbody>
                                        @foreach (var student in Students)
                                        {
                                            <tr>
                                                <td>@student.StudentId</td>
                                                <td>@student.Name</td>
                                                <td>@student.LastActivity</td>
                                                <td>
                                                    <span class="@(student.IsInactive ? "admin-status-pill admin-status-warning" : "admin-status-pill")">
                                                        @(student.IsInactive ? "Inactive" : "Active")
                                                    </span>
                                                </td>
                                                <td>
                                                    <button class="admin-view-btn"
                                                            @onclick='() => Nav.NavigateTo($"/admin/student-activity/{student.StudentId}")'>
                                                        View Activity
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>

                                @if (!Students.Any())
                                {
                                    <p style="padding:10px;">no student activity found.</p>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    string? errorMessage;
    bool isLoading = true;

    public SystemOverviewModel Overview { get; set; } = new();
    public List<StudentActivitySummary> Students { get; set; } = new();

    // this runs after the page first renders so we can access session storage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadSystemActivity();
        StateHasChanged();
    }

    // this loads system activity from the backend
    private async Task LoadSystemActivity()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/admin/system-activity");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<SystemActivityResponse>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "failed to load system activity";
                isLoading = false;
                return;
            }

            Overview.TotalStudents = result.Data.TotalStudents;
            Overview.ActiveThisWeek = result.Data.ActiveThisWeek;
            Overview.InactiveStudents = result.Data.InactiveStudents;
            Overview.WeeklyBookings = result.Data.WeeklyBookings;

            Students = result.Data.Students;

            isLoading = false;
        }
        catch
        {
            errorMessage = "error loading system activity";
            isLoading = false;
        }
    }

    // this stores the overview numbers shown at the top of the page
    public class SystemOverviewModel
    {
        public int TotalStudents { get; set; }
        public int ActiveThisWeek { get; set; }
        public int InactiveStudents { get; set; }
        public int WeeklyBookings { get; set; }
    }

    // this matches each student activity row returned by the backend
    public class StudentActivitySummary
    {
        public string StudentId { get; set; } = "";
        public string Name { get; set; } = "";
        public string LastActivity { get; set; } = "";
        public bool IsInactive { get; set; }
    }

    // this matches the backend response from api/admin/system-activity
    public class SystemActivityResponse
    {
        public int TotalStudents { get; set; }
        public int ActiveThisWeek { get; set; }
        public int InactiveStudents { get; set; }
        public int WeeklyBookings { get; set; }
        public List<StudentActivitySummary> Students { get; set; } = new();
    }

    // this matches the standard api response format
    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}