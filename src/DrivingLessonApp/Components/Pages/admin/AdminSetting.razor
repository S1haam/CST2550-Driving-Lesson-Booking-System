@page "/admin/settings"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="admin-main-content admin-settings-page admin-detail-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Settings</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading settings...</p>
    }
    else
    {
        <div class="admin-outer-card">
            <div class="admin-inner-card">
                <div class="admin-detail-panel">
                    <div class="admin-detail-grid">

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Account Information</div>

                            <div class="editable-row">
                                <strong>Name:</strong>
                                @if (editingField == "name")
                                {
                                    <input class="settings-input-inline" @bind="Admin.AdminName" />
                                }
                                else
                                {
                                    <span>@Admin.AdminName</span>
                                }
                                <button class="edit-btn" @onclick='() => StartEditing("name")'>Edit</button>
                            </div>

                            <div class="editable-row">
                                <strong>Email:</strong>
                                @if (editingField == "email")
                                {
                                    <input class="settings-input-inline" @bind="Admin.AdminEmail" />
                                }
                                else
                                {
                                    <span>@Admin.AdminEmail</span>
                                }
                                <button class="edit-btn" @onclick='() => StartEditing("email")'>Edit</button>
                            </div>

                            <div class="editable-row">
                                <strong>Phone Number:</strong>
                                @if (editingField == "phone")
                                {
                                    <input class="settings-input-inline" @bind="Admin.AdminPhone" />
                                }
                                else
                                {
                                    <span>@Admin.AdminPhone</span>
                                }
                                <button class="edit-btn" @onclick='() => StartEditing("phone")'>Edit</button>
                            </div>

                            <div class="editable-row">
                                <strong>Account Status:</strong>

                                @if (editingField == "status")
                                {
                                    <div class="status-toggle-row">
                                        <button type="button"
                                                class="status-toggle-btn @(Admin.Status == "Active" ? "status-selected-active" : "")"
                                                @onclick='() => SetStatus("Active")'>
                                            Active
                                        </button>

                                        <button type="button"
                                                class="status-toggle-btn @(Admin.Status == "Inactive" ? "status-selected-inactive" : "")"
                                                @onclick='() => SetStatus("Inactive")'>
                                            Inactive
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <span class="admin-status-pill @(Admin.Status == "Inactive" ? "admin-status-inactive" : "")">
                                        @Admin.Status
                                    </span>
                                }

                                <button class="edit-btn" @onclick='() => StartEditing("status")'>Edit</button>
                            </div>

                            <button class="small-btn save-info-btn" @onclick="SaveChanges">
                                Save Changes
                            </button>

                            @if (changesSaved)
                            {
                                <p class="success-text">Changes saved</p>
                            }
                        </div>

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Security Settings</div>

                            <button class="admin-primary-btn"
                                    @onclick='() => Nav.NavigateTo("/admin/change-password")'>
                                Change Password
                            </button>

                            <p><strong>Last password change:</strong> @Admin.LastPasswordChange.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                            <p><strong>Preferred Contact:</strong> Email</p>
                            <p><strong>Account Access:</strong> Full Admin Access</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    string? errorMessage;
    bool isLoading = true;
    bool changesSaved = false;
    string editingField = "";

    public AdminModel Admin { get; set; } = new();

    // this runs after the page first renders so we can access session storage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadSettings();
        StateHasChanged();
    }

    // this loads the admin settings from the backend
    private async Task LoadSettings()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/admin/settings");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<AdminModel>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "failed to load settings";
                isLoading = false;
                return;
            }

            Admin = result.Data;
            isLoading = false;
        }
        catch
        {
            errorMessage = "error loading settings";
            isLoading = false;
        }
    }

    // this saves the admin settings changes to the backend
    private async Task SaveChanges()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.PutAsJsonAsync("api/admin/settings/update", Admin);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "failed to save settings";
                return;
            }

            editingField = "";
            changesSaved = true;
        }
        catch
        {
            errorMessage = "error saving settings";
        }
    }

    // this sets which field is currently editable
    void StartEditing(string field)
    {
        editingField = field;
        changesSaved = false;
    }

    // this updates the selected admin status before saving
    void SetStatus(string status)
    {
        Admin.Status = status;
    }

    // this matches the admin settings data returned by the backend
    public class AdminModel
    {
        public int AdminId { get; set; }
        public string AdminName { get; set; } = "";
        public string AdminEmail { get; set; } = "";
        public string AdminPhone { get; set; } = "";
        public string Status { get; set; } = "";
        public DateTime LastPasswordChange { get; set; }
    }

    // this matches the standard api response format
    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}