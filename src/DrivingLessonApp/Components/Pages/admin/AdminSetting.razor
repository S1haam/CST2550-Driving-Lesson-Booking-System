@page "/admin/settings"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="admin-main-content admin-settings-page admin-detail-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Settings</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    <div class="admin-outer-card">
        <div class="admin-inner-card">
            <div class="admin-detail-panel">
                <div class="admin-detail-grid">

                    <div class="admin-detail-box">
                        <div class="admin-section-label">Account Information</div>

                        <div class="editable-row">
                            <strong>Name:</strong>
                            @if (editingField == "name")
                            {
                                <input class="settings-input-inline" @bind="Admin.Name" />
                            }
                            else
                            {
                                <span>@Admin.Name</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("name")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Email:</strong>
                            @if (editingField == "email")
                            {
                                <input class="settings-input-inline" @bind="Admin.Email" />
                            }
                            else
                            {
                                <span>@Admin.Email</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("email")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Phone Number:</strong>
                            @if (editingField == "phone")
                            {
                                <input class="settings-input-inline" @bind="Admin.Phone" />
                            }
                            else
                            {
                                <span>@Admin.Phone</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("phone")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Account Status:</strong>

                            @if (editingField == "status")
                            {
                                <div class="status-toggle-row">
                                    <button type="button"
                                            class="status-toggle-btn @(Admin.Status == "Active" ? "status-selected-active" : "")"
                                            @onclick='() => SetStatus("Active")'>
                                        Active
                                    </button>

                                    <button type="button"
                                            class="status-toggle-btn @(Admin.Status == "Inactive" ? "status-selected-inactive" : "")"
                                            @onclick='() => SetStatus("Inactive")'>
                                        Inactive
                                    </button>
                                </div>
                            }
                            else
                            {
                                <span class="admin-status-pill @(Admin.Status == "Inactive" ? "admin-status-inactive" : "")">
                                    @Admin.Status
                                </span>
                            }

                            <button class="edit-btn" @onclick='() => StartEditing("status")'>Edit</button>
                        </div>

                        <button class="small-btn save-info-btn" @onclick="SaveChanges">
                            Save Changes
                        </button>

                        @if (changesSaved)
                        {
                            <p class="success-text">Changes saved</p>
                        }
                    </div>

                    <div class="admin-detail-box">
                        <div class="admin-section-label">Security Settings</div>

                        <button class="admin-primary-btn"
                                @onclick='() => Nav.NavigateTo("/admin/change-password")'>
                            Change Password
                        </button>

                        <p><strong>Last password change:</strong> @Admin.LastPasswordChange</p>
                        <p><strong>Preferred Contact:</strong> Email</p>
                        <p><strong>Account Access:</strong> Full Admin Access</p>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    public class SettingsModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Status { get; set; } = "";
        public string LastPasswordChange { get; set; } = "";
    }

    public SettingsModel Admin { get; set; } = new SettingsModel
    {
        Name = "Admin User",
        Email = "au@gmail.com",
        Phone = "07345678912",
        Status = "Active",
        LastPasswordChange = "05/10/2025"
    };

    string editingField = "";
    bool changesSaved = false;

    void StartEditing(string field)
    {
        editingField = field;
        changesSaved = false;
    }

    void SetStatus(string status)
    {
        Admin.Status = status;
    }

    void SaveChanges()
    {
        editingField = "";
        changesSaved = true;
    }
}