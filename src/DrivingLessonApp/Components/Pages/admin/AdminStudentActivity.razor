@page "/admin/student-activity/{id}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="admin-main-content admin-student-activity-page admin-detail-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Student Activity</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading student activity...</p>
    }
    else
    {
        <div class="admin-outer-card">
            <div class="admin-inner-card">
                <div class="admin-detail-panel">
                    <div class="admin-detail-grid">

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Student Summary</div>
                            <p><strong>Name:</strong> @Student.Name</p>
                            <p><strong>Email:</strong> @Student.Email</p>
                            <p><strong>Phone Number:</strong> @Student.Phone</p>
                            <p><strong>Lessons Booked:</strong> @Student.LessonsBooked</p>
                        </div>

                        <div class="admin-detail-box">
                            <div class="admin-section-label">Account Status</div>
                            <p><strong>Student ID:</strong> @id</p>
                            <p><strong>Last Active:</strong> @Student.LastActive</p>
                            <p>
                                <strong>Status:</strong>
                                <span class="@(Student.IsInactive ? "admin-status-pill admin-status-warning" : "admin-status-pill")">
                                    @(Student.IsInactive ? "Inactive" : "Active")
                                </span>
                            </p>

                            @if (Student.IsInactive)
                            {
                                <div class="admin-meta-row">
                                    <button class="admin-mini-card action-card"
                                            type="button"
                                            @onclick='() => Nav.NavigateTo("/admin/remove-students")'>
                                        <span>Inactive Account</span>
                                        <strong>Manage Removal</strong>
                                    </button>
                                </div>
                            }
                        </div>

                        <div class="admin-detail-box admin-detail-box-wide">
                            <div class="admin-section-label">Activity Timeline</div>

                            <div class="admin-timeline-list">
                                @foreach (var entry in Student.ActivityTimeline)
                                {
                                    <div class="admin-timeline-item">@entry</div>
                                }

                                @if (!Student.ActivityTimeline.Any())
                                {
                                    <div class="admin-timeline-item">no activity found</div>
                                }
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    }

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin/system-activity")'>
            Back to System Activity
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string id { get; set; } = "";

    string? errorMessage;
    bool isLoading = true;

    public StudentActivityModel Student { get; set; } = new();

    // this runs after the page first renders so we can access session storage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadStudentActivity();
        StateHasChanged();
    }

    // this loads one student's activity from the backend using the id in the url
    private async Task LoadStudentActivity()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(id))
            {
                errorMessage = "invalid student id";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/admin/student/{id}/activity");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<StudentActivityModel>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load student activity";
                isLoading = false;
                return;
            }

            Student = result.Data;
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading student activity";
            isLoading = false;
        }
    }

    // this matches the student activity data returned by api/admin/student/{id}/activity
    public class StudentActivityModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public int LessonsBooked { get; set; }
        public string LastActive { get; set; } = "";
        public bool IsInactive { get; set; }
        public List<string> ActivityTimeline { get; set; } = new();
    }

    // this matches the standard api response format
    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}