@page "/admin/students"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="admin-main-content admin-students-page admin-database-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Student Database</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading students...</p>
    }

    <div class="admin-outer-card">
        <div class="admin-inner-card">
            <div class="admin-table-shell admin-database-shell">
                <table class="admin-student-table admin-database-table">
                    <thead>
                        <tr>
                            <th>Student ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Lessons Booked</th>
                            <th>Profile</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var s in Students)
                        {
                            <tr class="admin-table-row">
                                <td><span class="admin-table-pill">@s.StudentId</span></td>
                                <td><span class="admin-table-pill">@s.Name</span></td>
                                <td><span class="admin-table-pill">@s.Email</span></td>
                                <td><span class="admin-table-pill">@s.Phone</span></td>
                                <td><span class="admin-table-pill">@s.LessonsBooked</span></td>
                                <td>
                                    <button class="admin-view-btn admin-database-view-btn" @onclick='() => ViewProfile(s.StudentId)'>
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!isLoading && !Students.Any() && string.IsNullOrWhiteSpace(errorMessage))
                {
                    <p style="padding:10px;">no students found.</p>
                }
            </div>
        </div>
    </div>

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    string? errorMessage;
    bool isLoading = true;

    public List<Student> Students { get; set; } = new();

    // this runs after the page first renders so we can access session storage
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadStudents();
        StateHasChanged();
    }

    // this loads all students from the backend for the admin student database
    private async Task LoadStudents()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/admin/students");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<Student>>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load students";
                isLoading = false;
                return;
            }

            Students = result.Data;
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading students";
            isLoading = false;
        }
    }

    // this opens the selected student profile page
    void ViewProfile(string id)
    {
        Nav.NavigateTo($"/admin/student/{id}");
    }

    // this matches the student table data returned by api/admin/students
    public class Student
    {
        public string StudentId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public int LessonsBooked { get; set; }
    }

    // this matches the standard api response format
    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}