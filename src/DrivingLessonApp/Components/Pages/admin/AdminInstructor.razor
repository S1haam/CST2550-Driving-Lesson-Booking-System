@page "/admin/instructors"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="admin-main-content admin-instructors-page admin-database-page">
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Instructor Database</h3>

    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading instructors...</p>
    }

    <div class="admin-outer-card">
        <div class="admin-inner-card">
            <div class="admin-table-shell admin-database-shell">
                <table class="admin-database-table">
                    <thead>
                        <tr>
                            <th>Instructor ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone Number</th>
                            <th>Availability</th>
                            <th>Profile</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var i in Instructors)
                        {
                            <tr class="admin-table-row">
                                <td><span class="admin-table-pill">@i.InstructorId</span></td>
                                <td><span class="admin-table-pill">@i.Name</span></td>
                                <td><span class="admin-table-pill">@i.Email</span></td>
                                <td><span class="admin-table-pill">@i.Phone</span></td>
                                <td><span class="admin-table-pill">@i.Availability</span></td>
                                <td>
                                    <button class="admin-view-btn admin-database-view-btn" @onclick='() => ViewProfile(i.InstructorId)'>
                                        View
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!isLoading && !Instructors.Any())
                {
                    <p>no instructors found</p>
                }
            </div>
        </div>
    </div>

    <div class="admin-back-container">
        <button class="admin-tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    string? errorMessage;
    bool isLoading = true;

    public List<Instructor> Instructors { get; set; } = new();

    // this runs after render so we can access session storage token
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInstructors();
        StateHasChanged();
    }

    // this loads instructors from backend api
    private async Task LoadInstructors()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/admin/instructors");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<Instructor>>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "failed to load instructors";
                isLoading = false;
                return;
            }

            Instructors = result.Data;
            isLoading = false;
        }
        catch
        {
            errorMessage = "error loading instructors";
            isLoading = false;
        }
    }

    void ViewProfile(string id)
    {
        Nav.NavigateTo($"/admin/instructor/{id}");
    }

    // this matches backend instructor list response
    public class Instructor
    {
        public string InstructorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Availability { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}