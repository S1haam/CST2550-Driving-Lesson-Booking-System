@page "/admin"
@rendermode InteractiveServer
@inject NavigationManager Nav

<!--Main admin container-->
<div class="admin-main-content admin-home-page">

   <!--Title-->
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Admin Dashboard</h3>

<!--Navigation-->
    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

<!--Main admin content-->
    <div class="admin-home-card">
        <div class="admin-home-grid">

<!--Student Database Navigation-->
            <button class="admin-home-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>
                <span>Manage</span>
                <strong>Student Database</strong>
            </button>

<!--Instructor Database Navigation-->
            <button class="admin-home-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>
                <span>Manage</span>
                <strong>Instructor Database</strong>
            </button>

<!--Monitoring system activity Navigation-->
            <button class="admin-home-btn" @onclick='() => Nav.NavigateTo("/admin/system-activity")'>
                <span>Monitor</span>
                <strong>System Activity</strong>
            </button>

<!--Admin Settings page-->
            <button class="admin-home-btn" @onclick='() => Nav.NavigateTo("/admin/settings")'>
                <span>Manage</span>
                <strong>Settings</strong>
            </button>
        </div>
    </div>
</div>
