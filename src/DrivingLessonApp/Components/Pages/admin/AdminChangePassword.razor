@page "/admin/change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<!--Container-->
<div class="admin-main-content">

<!--Title-->
    <div class="admin-brand-title">SER Driving School</div>

    <h3 class="admin-page-title">Change Password</h3>

<!--Navigation-->
    <div class="admin-home-nav-wrap">
        <div class="admin-home-nav">
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
            <button class="admin-home-nav-btn" @onclick='() => Nav.NavigateTo("/admin/logout")'>Log out</button>
        </div>
    </div>

<!--Password change container-->
    <div class="admin-password-shell">
        <div class="admin-password-card">

            <h4 class="admin-password-heading">Change Password</h4>

<!--Error Message-->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <p style="color:red">@errorMessage</p>
            }
<!--Current password input-->
            <input type="password"
                   class="admin-password-input"
                   placeholder="Current Password"
                   @bind="currentPassword" />

<!--New Password-->
            <input type="password"
                   class="admin-password-input"
                   placeholder="New Password"
                   @bind="newPassword" />

<!--Confirm new Password-->
            <input type="password"
                   class="admin-password-input"
                   placeholder="Confirm New Password"
                   @bind="confirmPassword" />

<!--Submit Button-->
            <button class="admin-password-update-btn"
                    disabled="@isSubmitting"
                    @onclick="UpdatePassword">
                @(isSubmitting ? "Updating..." : "Update Password")
            </button>

<!--Back button-->
            <button class="admin-password-back-btn"
                    @onclick='() => Nav.NavigateTo("/admin/settings")'>
                Back
            </button>

<!--Success Message-->
            @if (passwordChanged)
            {
                <p class="success-text">Password changed successfully. Logging out...</p>
            }

        </div>
    </div>
</div>

@code {
//Form Fields
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

//UI state
    string? errorMessage;
    bool passwordChanged = false;
    bool isSubmitting = false;

    // this stores the password change data sent to the backend
    public class AdminChangePasswordRequest
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
    }

    // this matches the standard api response format
    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    // this validates the password fields and calls the admin password change api
    async Task UpdatePassword()
    {
        if (isSubmitting)
            return;

        errorMessage = null;
        passwordChanged = false;

//Trim Input values
        var cleanCurrentPassword = currentPassword?.Trim() ?? "";
        var cleanNewPassword = newPassword?.Trim() ?? "";
        var cleanConfirmPassword = confirmPassword?.Trim() ?? "";

//Required field validation
        if (string.IsNullOrWhiteSpace(cleanCurrentPassword) ||
            string.IsNullOrWhiteSpace(cleanNewPassword) ||
            string.IsNullOrWhiteSpace(cleanConfirmPassword))
        {
            errorMessage = "all fields are required";
            return;
        }
//Password rule validation
        if (!IsValidPassword(cleanNewPassword))
        {
            errorMessage = "password must be at least 6 characters and include one uppercase letter and one number";
            return;
        }

//Confirm password check
        if (cleanNewPassword != cleanConfirmPassword)
        {
            errorMessage = "passwords do not match";
            return;
        }

        isSubmitting = true;

        try
        {
//Retrieve admin auth token from session storage
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

//If token is missing, redirect to login
            if (string.IsNullOrWhiteSpace(token))
            {
                isSubmitting = false;
                Nav.NavigateTo("/login?role=admin");
                return;
            }

//Attach token request
            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

//Send Password update request
            var response = await Http.PutAsJsonAsync(
                "api/admin/settings/change-password",
                new AdminChangePasswordRequest
                {
                    CurrentPassword = cleanCurrentPassword,
                    NewPassword = cleanNewPassword
                });

//Parse API response
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

//Handle failure
            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "failed to change password";
                isSubmitting = false;
                return;
            }

//Success state
            passwordChanged = true;

//Clear session and log out
            await JS.InvokeVoidAsync("sessionStorage.clear");

            await Task.Delay(2000);

            Nav.NavigateTo("/login?role=admin");
        }
        catch
        {
//Generic error fallback
            errorMessage = "something went wrong while changing password";
            isSubmitting = false;
        }
    }

    // this checks the password rule used across the system
    bool IsValidPassword(string password)
    {
        return password.Length >= 6 &&
               password.Any(char.IsUpper) &&
               password.Any(char.IsDigit);
    }
}
