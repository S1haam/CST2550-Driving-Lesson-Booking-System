@page "/signup-instructor"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.RegularExpressions

<div class="booking-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>Sign Up: Instructor</h3>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input placeholder="Instructor ID" @bind="instructorId" />
    <input placeholder="Full Name" @bind="name" />
    <input type="email" placeholder="Email Address" @bind="email" />
    <input placeholder="Phone Number" @bind="phone" />
    <input type="password" placeholder="Password" @bind="password" />
    <input type="password" placeholder="Confirm Password" @bind="confirmPassword" />

    <select @bind="carType" class="booking-select">
        <option value="">Select Car Type</option>
        <option value="Manual">Manual</option>
        <option value="Automatic">Automatic</option>
    </select>

    <button class="booking-btn" @onclick="RegisterInstructor" disabled="@isSubmitting">
        @(isSubmitting ? "Submitting..." : "Sign Up")
    </button>

    <button class="booking-back" @onclick='() => Nav.NavigateTo("/login?role=instructor")'>
        Back
    </button>

</div>

@code {
    string? instructorId;
    string? name;
    string? email;
    string? phone;
    string? password;
    string? confirmPassword;
    string? carType;

    string? errorMessage;
    bool isSubmitting;

    // this validates instructor signup input and calls the backend
    async Task RegisterInstructor()
    {
        errorMessage = null;

        var cleanInstructorId = instructorId?.Trim() ?? "";
        var cleanName = name?.Trim() ?? "";
        var cleanEmail = email?.Trim() ?? "";
        var cleanPhone = phone?.Trim() ?? "";
        var cleanPassword = password?.Trim() ?? "";
        var cleanConfirmPassword = confirmPassword?.Trim() ?? "";
        var cleanCarType = carType?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(cleanInstructorId) ||
            string.IsNullOrWhiteSpace(cleanName) ||
            string.IsNullOrWhiteSpace(cleanEmail) ||
            string.IsNullOrWhiteSpace(cleanPhone) ||
            string.IsNullOrWhiteSpace(cleanPassword) ||
            string.IsNullOrWhiteSpace(cleanConfirmPassword) ||
            string.IsNullOrWhiteSpace(cleanCarType))
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        if (!IsValidEmail(cleanEmail))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        if (!IsValidPhone(cleanPhone))
        {
            errorMessage = "Phone number must be exactly 11 numbers.";
            return;
        }

        if (!IsValidPassword(cleanPassword))
        {
            errorMessage = "Password must be at least 6 characters and include one uppercase letter and one number.";
            return;
        }

        if (cleanPassword != cleanConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        if (cleanCarType != "Manual" && cleanCarType != "Automatic")
        {
            errorMessage = "Please select a valid car type.";
            return;
        }

        isSubmitting = true;

        var request = new RegisterInstructorRequest
        {
            InstructorCode = cleanInstructorId,
            InstructorName = cleanName,
            InstructorEmail = cleanEmail,
            InstructorPhone = cleanPhone,
            InstructorCarType = cleanCarType,
            Password = cleanPassword
        };

        var response = await Http.PostAsJsonAsync("api/auth/register/instructor", request);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        isSubmitting = false;

        if (!response.IsSuccessStatusCode || result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "Could not create instructor account.";
            return;
        }

        Nav.NavigateTo("/login?role=instructor");
    }

    // this validates email format
    bool IsValidEmail(string value)
    {
        return new EmailAddressAttribute().IsValid(value) &&
               value.Contains("@") &&
               value.Contains(".") &&
               Regex.IsMatch(value, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    }

    // this validates password strength
    bool IsValidPassword(string value)
    {
        return value.Length >= 6 &&
               value.Any(char.IsUpper) &&
               value.Any(char.IsDigit);
    }

    // this validates phone number
    bool IsValidPhone(string value)
    {
        return Regex.IsMatch(value, @"^\d{11}$");
    }

    public class RegisterInstructorRequest
    {
        public string InstructorCode { get; set; } = "";
        public string InstructorName { get; set; } = "";
        public string InstructorEmail { get; set; } = "";
        public string? InstructorPhone { get; set; }
        public string InstructorCarType { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}