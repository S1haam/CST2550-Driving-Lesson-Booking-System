@page "/instructor-cancel-summary"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Cancellation Summary</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading cancellation summary...</p>
}
else
{
    <div class="booking-card">

        <h1>Cancellation Summary</h1>

        <p>Please review your cancellation details:</p>

        <div class="summary-box">

            <div class="summary-item">
                <strong>Booking ID:</strong> @bookingId
            </div>

            <div class="summary-item">
                <strong>Student:</strong> @studentName
            </div>

            <div class="summary-item">
                <strong>Date:</strong> @lessonDate
            </div>

            <div class="summary-item">
                <strong>Time:</strong> @lessonTime
            </div>

            <div class="summary-item">
                <strong>Status after action:</strong> Cancelled
            </div>

        </div>

        <button class="booking-back"
                @onclick='() => Nav.NavigateTo($"/instructor-cancel-booking?bookingId={bookingId}")'>
            Back
        </button>

        <button class="booking-btn"
                disabled="@isSubmitting"
                @onclick="ConfirmCancellation">
            @(isSubmitting ? "Cancelling..." : "Confirm cancellation")
        </button>

    </div>
}

@code {
    int bookingId;
    bool isLoading = true;
    bool isSubmitting = false;
    string? errorMessage;

    string studentName = "";
    string lessonDate = "";
    string lessonTime = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("bookingId", out var bookingValue))
        {
            int.TryParse(bookingValue, out bookingId);
        }

        await LoadBooking();
        StateHasChanged();
    }

    // this loads booking details for the cancellation summary
    private async Task LoadBooking()
    {
        try
        {
            if (bookingId <= 0)
            {
                errorMessage = "invalid booking id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/instructor/schedule/booking/{bookingId}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorScheduleLessonDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load booking.";
                isLoading = false;
                return;
            }

            studentName = result.Data.LearnerName;
            lessonDate = result.Data.LessonDate.ToString("dd/MM/yyyy");
            lessonTime = result.Data.LessonTime.ToString(@"hh\:mm");

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading booking.";
            isLoading = false;
        }
    }

    // this confirms the cancellation with the backend
    private async Task ConfirmCancellation()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.PutAsync($"api/instructor/schedule/cancel/{bookingId}", null);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "could not cancel booking.";
                isSubmitting = false;
                return;
            }

            Nav.NavigateTo($"/instructor-cancel-confirmed?bookingId={bookingId}");
        }
        catch
        {
            errorMessage = "something went wrong while cancelling booking.";
            isSubmitting = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorScheduleLessonDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public string? InstructorNotes { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}