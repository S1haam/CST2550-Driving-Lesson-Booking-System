@page "/instructor-delete-account"
@rendermode InteractiveServer
@inject NavigationManager Nav

<h3>Delete Account</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Delete Account</h1>

    <p class="delete-warning">
        Deleting your account is permanent. All your schedule data, inbox messages, and personal information will be removed.
        This action cannot be undone.
    </p>

    <input type="password"
           placeholder="Enter your password to confirm"
           @bind="password" />

    <input placeholder="Type DELETE to confirm"
           @bind="confirmText" />

    <button class="delete-btn full @(CanDelete ? "" : "inactive")"
            @onclick="HandleDelete">
        Delete My Account
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/instructor-settings")'>
        Back
    </button>

</div>

@code {
    string? password;
    string? confirmText;

    bool CanDelete =>
        confirmText == "DELETE" &&
        !string.IsNullOrWhiteSpace(password);

    void HandleDelete()
    {
        if (!CanDelete)
            return;

        Nav.NavigateTo("/instructor-delete-success");
    }
}