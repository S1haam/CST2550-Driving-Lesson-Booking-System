@page "/instructor-cancelled-notification/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Cancelled Booking</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading notification...</p>
}
else
{
    <div class="instructor-message-card">
        <p>@notificationTitle</p>
        <p>@notificationDateText</p>

        <button class="booking-btn"
                @onclick='() => Nav.NavigateTo("/instructor-inbox")'>
            Back
        </button>
    </div>
}

@code {
    [Parameter] public int id { get; set; }

    string? errorMessage;
    bool isLoading = true;

    string notificationTitle = "";
    string notificationDateText = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadNotification();
        StateHasChanged();
    }

    private async Task LoadNotification()
    {
        try
        {
            if (id <= 0)
            {
                errorMessage = "invalid notification id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/instructor/notification/{id}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<NotificationDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load notification";
                isLoading = false;
                return;
            }

            if (result.Data.NotificationType != "CancelledBooking")
            {
                errorMessage = "this is not a cancelled booking notification";
                isLoading = false;
                return;
            }

            notificationTitle = result.Data.Message;
            notificationDateText = result.Data.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading notification";
            isLoading = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class NotificationDto
    {
        public int NotificationId { get; set; }
        public int InstructorId { get; set; }
        public string Message { get; set; } = "";
        public string NotificationType { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public bool IsRead { get; set; }
        public bool IsPinned { get; set; }
        public bool IsDeleted { get; set; }
    }
}