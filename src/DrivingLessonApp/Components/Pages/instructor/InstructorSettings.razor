@page "/instructor-settings"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Settings</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<div class="instructor-settings-container">
    <div class="instructor-settings-layout">

        <div class="instructor-settings-sidebar">
            <h4>Options:</h4>

            <div class="instructor-settings-options">
                <button class="@(instructorSelectedSection == "schedule" ? "active-option" : "")"
                        @onclick='() => instructorSelectedSection = "schedule"'>
                    Schedule Information
                </button>

                <button class="@(instructorSelectedSection == "account" ? "active-option" : "")"
                        @onclick='() => instructorSelectedSection = "account"'>
                    Account Information
                </button>

                <button class="@(instructorSelectedSection == "status" ? "active-option" : "")"
                        @onclick='() => instructorSelectedSection = "status"'>
                    Status
                </button>
            </div>

            <button class="instructor-settings-logout"
                    @onclick='() => Nav.NavigateTo("/")'>
                Log Out
            </button>

            <button class="instructor-settings-logout"
                    @onclick='() => Nav.NavigateTo("/instructor-delete-account")'>
                Delete Account
            </button>
        </div>

        <div class="instructor-settings-content">

            @if (instructorSelectedSection == "schedule")
            {
                <h4>Schedule Information</h4>
                <p>Pick up to 5 available time slots.</p>
                <p>Current times: @string.Join(", ", instructorCurrentTimes)</p>

                <div class="instructor-time-grid">
                    @foreach (var instructorTime in instructorAvailableTimes)
                    {
                        <button class="instructor-time-btn @(instructorSelectedTimes.Contains(instructorTime) ? "selected-time" : "")"
                                @onclick="() => InstructorSelectTime(instructorTime)">
                            @instructorTime
                        </button>
                    }
                </div>

                <button class="instructor-settings-save" @onclick="InstructorSaveSchedule">
                    Save Changes
                </button>

                @if (instructorScheduleSaved)
                {
                    <p class="success-text">Schedule updated successfully.</p>
                }
            }

            @if (instructorSelectedSection == "account")
            {
                <h4>Account Information</h4>

                <div class="instructor-account-info-card">

                    <div class="editable-row">
                        <strong>Name:</strong>
                        @if (editingField == "name")
                        {
                            <input class="settings-input-inline" @bind="InstructorName" />
                        }
                        else
                        {
                            <span>@InstructorName</span>
                        }
                        <button class="edit-btn" @onclick='() => StartEditing("name")'>Edit</button>
                    </div>

                    <div class="editable-row">
                        <strong>Email:</strong>
                        @if (editingField == "email")
                        {
                            <input class="settings-input-inline" @bind="InstructorEmail" />
                        }
                        else
                        {
                            <span>@InstructorEmail</span>
                        }
                        <button class="edit-btn" @onclick='() => StartEditing("email")'>Edit</button>
                    </div>

                    <div class="editable-row">
                        <strong>Password:</strong>
                        @if (showPasswordForm)
                        {
                            <div class="inline-password-form">
                                <input type="password"
                                       class="settings-input-inline instructor-password-input"
                                       placeholder="Current Password"
                                       @bind="currentPassword" />

                                <input type="password"
                                       class="settings-input-inline instructor-password-input"
                                       placeholder="New Password"
                                       @bind="newPassword" />

                                <input type="password"
                                       class="settings-input-inline instructor-password-input"
                                       placeholder="Confirm New Password"
                                       @bind="confirmPassword" />

                                <button class="admin-password-update-btn"
                                        type="button"
                                        @onclick="UpdateInstructorPassword">
                                    Update Password
                                </button>

                                <button class="admin-password-back-btn"
                                        type="button"
                                        @onclick="ClosePasswordForm">
                                    Back
                                </button>

                                @if (passwordChanged)
                                {
                                    <p class="success-text">Password changed successfully. Redirecting to start page...</p>
                                }
                            </div>
                        }
                        else
                        {
                            <button class="admin-primary-btn"
                                    type="button"
                                    @onclick="OpenPasswordForm">
                                Change Password
                            </button>
                        }
                    </div>

                    <div class="editable-row">
                        <strong>Phone Number:</strong>
                        @if (editingField == "phone")
                        {
                            <input class="settings-input-inline" @bind="InstructorPhoneNumber" />
                        }
                        else
                        {
                            <span>@InstructorPhoneNumber</span>
                        }
                        <button class="edit-btn" @onclick='() => StartEditing("phone")'>Edit</button>
                    </div>

                    <div class="editable-row">
                        <strong>Instructor ID:</strong>
                        @if (editingField == "id")
                        {
                            <input class="settings-input-inline" @bind="InstructorId" />
                        }
                        else
                        {
                            <span>@InstructorId</span>
                        }
                        <button class="edit-btn" @onclick='() => StartEditing("id")'>Edit</button>
                    </div>

                    <button class="small-btn save-info-btn" @onclick="SaveInstructorChanges">
                        Save Changes
                    </button>

                    @if (instructorAccountSaved)
                    {
                        <p class="success-text">Changes saved</p>
                    }
                </div>
            }

            @if (instructorSelectedSection == "status")
            {
                <h4>Status</h4>

                <div class="status-setting-row">
                    <input type="radio"
                           name="instructorStatus"
                           checked="@(instructorStatus == "Active")"
                           @onchange='@(() => instructorStatus = "Active")' />
                    <label>Active</label>
                </div>

                <div class="status-setting-row">
                    <input type="radio"
                           name="instructorStatus"
                           checked="@(instructorStatus == "Inactive")"
                           @onchange='@(() => instructorStatus = "Inactive")' />
                    <label>Inactive</label>
                </div>

                <button class="instructor-settings-save" @onclick="InstructorSaveStatus">
                    Save Changes
                </button>

                @if (instructorStatusSaved)
                {
                    <p class="success-text">Status updated successfully.</p>
                }
            }

        </div>
    </div>
</div>

@code {
    string instructorSelectedSection = "account";

    List<string> instructorCurrentTimes = new() { "12:00pm", "1:00pm", "2:00pm", "3:00pm", "4:00pm" };

    List<string> instructorAvailableTimes = new()
    {
        "8:00am", "9:00am", "10:00am", "11:00am",
        "12:00pm", "1:00pm", "2:00pm", "3:00pm", "4:00pm"
    };

    List<string> instructorSelectedTimes = new();

    string instructorStatus = "Active";

    string InstructorName = "David Smith";
    string InstructorEmail = "david@gmail.com";
    string InstructorPhoneNumber = "07958294911";
    string InstructorId = "INS2045";

    string editingField = "";

    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    bool showPasswordForm = false;
    bool passwordChanged = false;

    bool instructorScheduleSaved = false;
    bool instructorAccountSaved = false;
    bool instructorStatusSaved = false;

    void InstructorSelectTime(string instructorTime)
    {
        instructorScheduleSaved = false;

        if (instructorSelectedTimes.Contains(instructorTime))
            instructorSelectedTimes.Remove(instructorTime);
        else if (instructorSelectedTimes.Count < 5)
            instructorSelectedTimes.Add(instructorTime);
    }

    void InstructorSaveSchedule()
    {
        instructorScheduleSaved = true;
    }

    void StartEditing(string field)
    {
        editingField = field;
        instructorAccountSaved = false;
    }

    void SaveInstructorChanges()
    {
        editingField = "";
        instructorAccountSaved = true;
    }

    void OpenPasswordForm()
    {
        showPasswordForm = true;
        passwordChanged = false;
    }

    void ClosePasswordForm()
    {
        showPasswordForm = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        passwordChanged = false;
    }

    async Task UpdateInstructorPassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            return;
        }

        if (newPassword != confirmPassword)
        {
            return;
        }

        passwordChanged = true;

        await Task.Delay(2000);

        Nav.NavigateTo("/");
    }

    void InstructorSaveStatus()
    {
        instructorStatusSaved = true;
    }
}