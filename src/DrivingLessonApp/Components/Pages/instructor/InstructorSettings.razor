@page "/instructor-settings"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Settings</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <p style="color:green; margin-bottom:10px;">@successMessage</p>
}

@if (isLoading)
{
    <p>loading settings...</p>
}
else
{
    <div class="instructor-settings-container">
        <div class="instructor-settings-layout">

            <div class="instructor-settings-sidebar">
                <h4>Options:</h4>

                <div class="instructor-settings-options">
                    <button class="@(instructorSelectedSection == "schedule" ? "active-option" : "")"
                            @onclick='() => Nav.NavigateTo("/instructor-settings-schedule")'>
                        Schedule Information
                    </button>

                    <button class="@(instructorSelectedSection == "account" ? "active-option" : "")"
                            @onclick='() => instructorSelectedSection = "account"'>
                        Account Information
                    </button>

                    <button class="@(instructorSelectedSection == "status" ? "active-option" : "")"
                            @onclick='() => instructorSelectedSection = "status"'>
                        Status
                    </button>
                </div>

                <button class="instructor-settings-logout"
                        @onclick="Logout">
                    Log Out
                </button>

                <button class="instructor-settings-logout"
                        @onclick='() => Nav.NavigateTo("/instructor-delete-account")'>
                    Delete Account
                </button>
            </div>

            <div class="instructor-settings-content">

                @if (instructorSelectedSection == "schedule")
                {
                    <h4>Schedule Information</h4>
                    <p>Go to the schedule settings page to manage availability.</p>

                    <button class="instructor-settings-save"
                            @onclick='() => Nav.NavigateTo("/instructor-settings-schedule")'>
                        Open Schedule Settings
                    </button>
                }

                @if (instructorSelectedSection == "account")
                {
                    <h4>Account Information</h4>

                    <div class="instructor-account-info-card">

                        <div class="editable-row">
                            <strong>Name:</strong>
                            @if (editingField == "name")
                            {
                                <input class="settings-input-inline" @bind="InstructorName" />
                            }
                            else
                            {
                                <span>@InstructorName</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("name")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Email:</strong>
                            @if (editingField == "email")
                            {
                                <input class="settings-input-inline" @bind="InstructorEmail" />
                            }
                            else
                            {
                                <span>@InstructorEmail</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("email")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Password:</strong>
                            @if (showPasswordForm)
                            {
                                <div class="inline-password-form">
                                    <input type="password"
                                           class="settings-input-inline instructor-password-input"
                                           placeholder="Current Password"
                                           @bind="currentPassword" />

                                    <input type="password"
                                           class="settings-input-inline instructor-password-input"
                                           placeholder="New Password"
                                           @bind="newPassword" />

                                    <input type="password"
                                           class="settings-input-inline instructor-password-input"
                                           placeholder="Confirm New Password"
                                           @bind="confirmPassword" />

                                    <button class="admin-password-update-btn"
                                            type="button"
                                            @onclick="UpdateInstructorPassword">
                                        Update Password
                                    </button>

                                    <button class="admin-password-back-btn"
                                            type="button"
                                            @onclick="ClosePasswordForm">
                                        Back
                                    </button>

                                    @if (passwordChanged)
                                    {
                                        <p class="success-text">Password changed successfully.</p>
                                    }
                                </div>
                            }
                            else
                            {
                                <button class="admin-primary-btn"
                                        type="button"
                                        @onclick="OpenPasswordForm">
                                    Change Password
                                </button>
                            }
                        </div>

                        <div class="editable-row">
                            <strong>Phone Number:</strong>
                            @if (editingField == "phone")
                            {
                                <input class="settings-input-inline" @bind="InstructorPhoneNumber" />
                            }
                            else
                            {
                                <span>@InstructorPhoneNumber</span>
                            }
                            <button class="edit-btn" @onclick='() => StartEditing("phone")'>Edit</button>
                        </div>

                        <div class="editable-row">
                            <strong>Instructor ID:</strong>
                            <span>@InstructorId</span>
                        </div>

                        <button class="small-btn save-info-btn" @onclick="SaveInstructorChanges">
                            Save Changes
                        </button>

                        @if (instructorAccountSaved)
                        {
                            <p class="success-text">Changes saved</p>
                        }
                    </div>
                }

                @if (instructorSelectedSection == "status")
                {
                    <h4>Status</h4>

                    <div class="status-setting-row">
                        <input type="radio"
                               name="instructorStatus"
                               checked="@(instructorStatus == "Active")"
                               @onchange='@(() => instructorStatus = "Active")' />
                        <label>Active</label>
                    </div>

                    <div class="status-setting-row">
                        <input type="radio"
                               name="instructorStatus"
                               checked="@(instructorStatus == "Inactive")"
                               @onchange='@(() => instructorStatus = "Inactive")' />
                        <label>Inactive</label>
                    </div>

                    <button class="instructor-settings-save" @onclick="InstructorSaveStatus">
                        Save Changes
                    </button>

                    @if (instructorStatusSaved)
                    {
                        <p class="success-text">Status updated successfully.</p>
                    }
                }

            </div>
        </div>
    </div>
}

@code {
    string instructorSelectedSection = "account";

    string instructorStatus = "Active";

    string InstructorName = "";
    string InstructorEmail = "";
    string InstructorPhoneNumber = "";
    string InstructorId = "";

    string editingField = "";

    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    bool showPasswordForm = false;
    bool passwordChanged = false;

    bool instructorAccountSaved = false;
    bool instructorStatusSaved = false;
    bool isLoading = true;

    string? errorMessage;
    string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInstructorSettings();
        StateHasChanged();
    }

    // this loads the logged in instructor settings from the backend
    async Task LoadInstructorSettings()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/instructor/me");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorResponseDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load instructor settings";
                isLoading = false;
                return;
            }

            InstructorName = result.Data.InstructorName;
            InstructorEmail = result.Data.InstructorEmail;
            InstructorPhoneNumber = result.Data.InstructorPhone;
            InstructorId = result.Data.InstructorCode;
            instructorStatus = result.Data.InstructorStatus;

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading settings";
            isLoading = false;
        }
    }

    // this enables editing for one account field
    void StartEditing(string field)
    {
        editingField = field;
        instructorAccountSaved = false;
        successMessage = null;
        errorMessage = null;
    }

    // this saves the instructor account info to the backend
    async Task SaveInstructorChanges()
    {
        errorMessage = null;
        successMessage = null;
        instructorAccountSaved = false;

        var request = new UpdateInstructorRequest
        {
            InstructorName = InstructorName.Trim(),
            InstructorEmail = InstructorEmail.Trim(),
            InstructorPhone = InstructorPhoneNumber.Trim()
        };

        try
        {
            var response = await Http.PutAsJsonAsync("api/instructor/update", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "could not save instructor changes";
                return;
            }

            editingField = "";
            instructorAccountSaved = true;
            successMessage = "changes saved successfully.";
        }
        catch
        {
            errorMessage = "something went wrong while saving changes";
        }
    }

    // this opens the password change form
    void OpenPasswordForm()
    {
        showPasswordForm = true;
        passwordChanged = false;
        successMessage = null;
        errorMessage = null;
    }

    // this closes and clears the password change form
    void ClosePasswordForm()
    {
        showPasswordForm = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
        passwordChanged = false;
    }

    // this sends the password change request to the backend
    async Task UpdateInstructorPassword()
    {
        errorMessage = null;
        successMessage = null;
        passwordChanged = false;

        var request = new ChangeInstructorPasswordRequest
        {
            CurrentPassword = currentPassword ?? "",
            NewPassword = newPassword ?? "",
            ConfirmPassword = confirmPassword ?? ""
        };

        try
        {
            var response = await Http.PutAsJsonAsync("api/instructor/change-password", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "could not change password";
                return;
            }

            passwordChanged = true;
            successMessage = "password changed successfully.";
            ClosePasswordForm();
        }
        catch
        {
            errorMessage = "something went wrong while changing password";
        }
    }

    // this saves the instructor status to the backend
    async Task InstructorSaveStatus()
    {
        errorMessage = null;
        successMessage = null;
        instructorStatusSaved = false;

        var request = new UpdateInstructorStatusRequest
        {
            InstructorStatus = instructorStatus
        };

        try
        {
            var response = await Http.PutAsJsonAsync("api/instructor/status", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "could not update status";
                return;
            }

            instructorStatusSaved = true;
            successMessage = "status updated successfully.";
        }
        catch
        {
            errorMessage = "something went wrong while updating status";
        }
    }

    // this logs the instructor out by clearing session storage
    async Task Logout()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userEmail");

        Nav.NavigateTo("/");
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorResponseDto
    {
        public int InstructorId { get; set; }
        public string InstructorCode { get; set; } = "";
        public string InstructorName { get; set; } = "";
        public string InstructorEmail { get; set; } = "";
        public string InstructorPhone { get; set; } = "";
        public string InstructorCarType { get; set; } = "";
        public string InstructorStatus { get; set; } = "";
    }

    public class UpdateInstructorRequest
    {
        public string InstructorName { get; set; } = "";
        public string InstructorEmail { get; set; } = "";
        public string InstructorPhone { get; set; } = "";
    }

    public class ChangeInstructorPasswordRequest
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    public class UpdateInstructorStatusRequest
    {
        public string InstructorStatus { get; set; } = "";
    }
}