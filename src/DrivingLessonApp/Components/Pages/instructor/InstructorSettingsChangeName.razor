@page "/instructor-change-name"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Change Name</h3>

<div class="booking-card">
    <input placeholder="Enter New Name..." @bind="name" />
    <input type="password" placeholder="Password" @bind="password" />

    <button type="button" class="booking-btn" @onclick="Save">
        Save
    </button>
</div>

@code {
    string? name;
    string? password;

    void Save()
    {
        Nav.NavigateTo("/instructor-settings-success");
    }
}