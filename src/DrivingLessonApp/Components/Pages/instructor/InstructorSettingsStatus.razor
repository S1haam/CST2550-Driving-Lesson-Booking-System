@page "/instructor-settings-status"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Settings</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <p style="margin-top:15px; color:green;">@successMessage</p>
}

@if (isLoading)
{
    <p>loading status...</p>
}
else
{
    <div class="row">

        <div class="col-md-3 py-4 px-3">
            <div class="card shadow-sm">
                <input type="checkbox" id="settingsDropdown" class="dropdown-toggle" />

                <div class="card-body">

                    <h5>Options:</h5>

                    <div class="instructor-settings-options">
                        <button @onclick='() => Nav.NavigateTo("/instructor-settings-schedule")'>
                            Schedule Information
                        </button>

                        <button @onclick='() => Nav.NavigateTo("/instructor-settings-account")'>
                            Account Information
                        </button>

                        <button @onclick='() => Nav.NavigateTo("/instructor-settings-status")'>
                            Status
                        </button>
                    </div>

                    <button class="btn btn-danger mt-4 w-100"
                            @onclick="Logout">
                        Log out
                    </button>

                </div>
            </div>
        </div>

        <div class="col-md-9 py-4 px-3">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h5>Status</h5>

                    <div>
                        <input type="radio"
                               name="status"
                               checked="@(status == "Active")"
                               @onchange="@(() => status = "Active")" />
                        <label>Active</label>
                    </div>

                    <div>
                        <input type="radio"
                               name="status"
                               checked="@(status == "Inactive")"
                               @onchange="@(() => status = "Inactive")" />
                        <label>Inactive</label>
                    </div>

                    <br />

                    <button class="btn btn-success"
                            disabled="@isSaving"
                            @onclick="Save">
                        @(isSaving ? "Saving..." : "Save Changes")
                    </button>

                </div>
            </div>
        </div>

    </div>
}

@code {
    string status = "Active";
    bool isLoading = true;
    bool isSaving = false;
    string? errorMessage;
    string? successMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadStatus();
        StateHasChanged();
    }

    // this loads the logged in instructor status from the backend
    async Task LoadStatus()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/instructor/me");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorResponseDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load instructor status";
                isLoading = false;
                return;
            }

            status = result.Data.InstructorStatus;
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading status";
            isLoading = false;
        }
    }

    // this saves the instructor status to the backend
    async Task Save()
    {
        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            var request = new UpdateInstructorStatusRequest
            {
                InstructorStatus = status
            };

            var response = await Http.PutAsJsonAsync("api/instructor/status", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "could not save status";
                isSaving = false;
                return;
            }

            successMessage = "successfully changed status!";
            isSaving = false;
        }
        catch
        {
            errorMessage = "something went wrong while saving status";
            isSaving = false;
        }
    }

    // this logs the instructor out
    async Task Logout()
    {
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userEmail");

        Nav.NavigateTo("/");
    }

    public class UpdateInstructorStatusRequest
    {
        public string InstructorStatus { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorResponseDto
    {
        public int InstructorId { get; set; }
        public string InstructorCode { get; set; } = "";
        public string InstructorName { get; set; } = "";
        public string InstructorEmail { get; set; } = "";
        public string InstructorPhone { get; set; } = "";
        public string InstructorCarType { get; set; } = "";
        public string InstructorStatus { get; set; } = "";
    }
}