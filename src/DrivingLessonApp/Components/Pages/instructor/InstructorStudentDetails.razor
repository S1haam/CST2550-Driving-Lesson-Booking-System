@page "/instructor-learner/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Student Details</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading student details...</p>
}
else
{
    <div class="instructor-student-card">

        <h2>@studentName</h2>

        <ul>
            <li>Licence ID: @studentLicenceId</li>
            <li>Contact Number: @studentPhone</li>
            <li>Email: @studentEmail</li>
            <li>Status: @studentStatus</li>
            <li>Past Lessons: @pastLessonCount</li>
            <li>Upcoming Lessons: @nextLessonCount</li>
        </ul>

        <button class="instructor-danger-btn"
                @onclick='() => Nav.NavigateTo($"/instructor-remove-confirm/{id}")'>
            Remove Student
        </button>

    </div>
}

@code {
    [Parameter] public int id { get; set; }

    string? errorMessage;
    bool isLoading = true;

    string studentName = "";
    string studentLicenceId = "";
    string studentPhone = "";
    string studentEmail = "";
    string studentStatus = "";
    int pastLessonCount = 0;
    int nextLessonCount = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadStudentDetails();
        StateHasChanged();
    }

    // this loads the selected learner for the logged in instructor
    private async Task LoadStudentDetails()
    {
        try
        {
            if (id <= 0)
            {
                errorMessage = "invalid student id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/instructor/learner/{id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "failed to load student details";
                isLoading = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorLearnerDetailsDto>>();

            if (result == null || !result.Success || result.Data == null)
            {
                errorMessage = "could not read student details";
                isLoading = false;
                return;
            }

            studentName = result.Data.LearnerName;
            studentLicenceId = result.Data.LearnerLicenceId;
            studentPhone = result.Data.LearnerPhone;
            studentEmail = result.Data.LearnerEmail;
            studentStatus = result.Data.LearnerStatus;
            pastLessonCount = result.Data.PastLessonCount;
            nextLessonCount = result.Data.NextLessonCount;

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading student details";
            isLoading = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorLearnerDetailsDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string LearnerLicenceId { get; set; } = "";
        public string LearnerEmail { get; set; } = "";
        public string LearnerPhone { get; set; } = "";
        public string LearnerStatus { get; set; } = "";
        public int PastLessonCount { get; set; }
        public int NextLessonCount { get; set; }
    }
}