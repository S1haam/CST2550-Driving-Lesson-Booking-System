@page "/instructorHome"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading instructor home...</p>
}

<h3>Instructor Home</h3>

<!-- NAV BAR -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<!-- MAIN PANEL -->
<div class="instructor-home-panel">

    <p class="welcome-text">Welcome Instructor, @instructorName</p>

    <div class="notif-bar">
        <span>You have 0 new notifications</span>
        <button class="notif-btn"
                @onclick='() => Nav.NavigateTo("/instructor-inbox")'>
            Check Inbox
        </button>
    </div>

    <div class="status-row">
        <span class="status-dot"></span>
        <span>@instructorStatus</span>
    </div>

    <div class="home-grid">

        <!-- UPCOMING LESSONS -->
        <div class="home-card">
            <div class="card-title">Upcoming lessons</div>

            @foreach (var instructorLesson in instructorLessons)
            {
                <div class="pill-row">
                    <span>@instructorLesson.DisplayText</span>
                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-lesson-details?id={instructorLesson.Id}&type=next")'>
                        View
                    </button>
                </div>
            }

            @if (!instructorLessons.Any())
            {
                <p>No upcoming lessons.</p>
            }
        </div>

        <!-- STUDENTS -->
        <div class="home-card">
            <div class="student-header-row">
                <div class="card-title student-card-title">Students</div>

                <div class="search-container student-search-container">
                    <input @bind="instructorStudentSearch"
                           placeholder="Search by ID" />
                    <button type="button">Search</button>
                </div>
            </div>

            @{
                var filteredInstructorStudents = FilteredInstructorStudents();
            }

            @foreach (var instructorStudent in filteredInstructorStudents)
            {
                <div class="pill-row">
                    <div class="student-left">
                        <div class="avatar-circle">@instructorStudent.Initials</div>
                        <span>@instructorStudent.LearnerName</span>
                    </div>

                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-learner/{instructorStudent.LearnerId}")'>
                        View
                    </button>
                </div>
            }

            @if (!filteredInstructorStudents.Any())
            {
                <p>No students found.</p>
            }

        </div>

    </div>

</div>

@code {
    string? errorMessage;
    bool isLoading = true;

    string instructorName = "Instructor";
    string instructorStatus = "Active";
    string instructorStudentSearch = "";

    List<InstructorHomeLesson> instructorLessons = new();
    List<InstructorHomeStudent> instructorStudents = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadInstructorHomeData();
        StateHasChanged();
    }

    private async Task LoadInstructorHomeData()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            await LoadInstructorProfile();
            await LoadUpcomingLessons();
            await LoadStudents();

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading instructor home";
            isLoading = false;
        }
    }

    private async Task LoadInstructorProfile()
    {
        var response = await Http.GetAsync("api/instructor/me");

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "failed to load instructor profile";
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorProfileDto>>();

        if (result == null || !result.Success || result.Data == null)
        {
            errorMessage = "could not read instructor profile";
            return;
        }

        instructorName = result.Data.InstructorName;
        instructorStatus = result.Data.InstructorStatus;
    }

    private async Task LoadUpcomingLessons()
    {
        var response = await Http.GetAsync("api/instructor/home/upcoming-lessons");

        if (!response.IsSuccessStatusCode)
            return;

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<InstructorHomeLesson>>>();

        if (result == null || !result.Success || result.Data == null)
            return;

        instructorLessons = result.Data;
    }

    private async Task LoadStudents()
    {
        var response = await Http.GetAsync("api/instructor/home/students");

        if (!response.IsSuccessStatusCode)
            return;

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<InstructorHomeStudent>>>();

        if (result == null || !result.Success || result.Data == null)
            return;

        instructorStudents = result.Data;
    }

    List<InstructorHomeStudent> FilteredInstructorStudents()
    {
        if (string.IsNullOrWhiteSpace(instructorStudentSearch))
            return instructorStudents;

        return instructorStudents
            .Where(instructorStudent =>
                instructorStudent.LearnerName.Contains(instructorStudentSearch, StringComparison.OrdinalIgnoreCase)
                || instructorStudent.LearnerId.ToString().Contains(instructorStudentSearch))
            .ToList();
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorProfileDto
    {
        public int InstructorId { get; set; }
        public string InstructorCode { get; set; } = "";
        public string InstructorName { get; set; } = "";
        public string InstructorEmail { get; set; } = "";
        public string InstructorPhone { get; set; } = "";
        public string InstructorCarType { get; set; } = "";
        public string InstructorStatus { get; set; } = "";
    }

    public class InstructorHomeLesson
    {
        public int Id { get; set; }
        public string LearnerName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string DisplayText { get; set; } = "";
    }

    public class InstructorHomeStudent
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";

        public string Initials =>
            string.Join("", LearnerName
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x[0]));
    }
}