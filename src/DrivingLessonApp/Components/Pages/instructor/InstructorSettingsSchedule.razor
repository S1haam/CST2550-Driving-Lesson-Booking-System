@page "/instructor-settings-schedule"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Settings</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin: 10px 0;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading schedule settings...</p>
}

<div class="instructor-settings-container">
    <div class="instructor-settings-layout">

        <div class="instructor-settings-sidebar">
            <h4>Options:</h4>

            <div class="instructor-settings-options">
                <button class="active-option"
                        @onclick='() => Nav.NavigateTo("/instructor-settings-schedule")'>
                    Schedule Information
                </button>

                <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>
                    Account Information
                </button>

                <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>
                    Status
                </button>
            </div>

            <button class="instructor-settings-logout"
                    @onclick='() => Nav.NavigateTo("/")'>
                Log Out
            </button>

            <button class="instructor-settings-logout"
                    @onclick='() => Nav.NavigateTo("/instructor-delete-account")'>
                Delete Account
            </button>
        </div>

        <div class="instructor-settings-content">
            <h4>Schedule Information</h4>
            <p>Choose a date, then pick up to 5 available time slots.</p>

            <div style="margin-bottom: 15px;">
                <label><strong>Select Date:</strong></label><br />
                <input type="date"
                       @bind="selectedDate"
                       @bind:format="yyyy-MM-dd"
                       class="settings-input-inline" />
            </div>

            @if (selectedDate.HasValue)
            {
                <p>Selected date: @selectedDate.Value.ToString("dd/MM/yyyy")</p>
            }

            <div class="instructor-time-grid">
                @foreach (var instructorTime in instructorAvailableTimes)
                {
                    <button type="button"
                            class="instructor-time-btn @(instructorSelectedTimes.Contains(instructorTime) ? "selected-time" : "")"
                            @onclick="() => InstructorSelectTime(instructorTime)">
                        @instructorTime
                    </button>
                }
            </div>

            <button class="instructor-settings-save" @onclick="InstructorSaveSchedule">
                Save Changes
            </button>

            @if (instructorScheduleSaved)
            {
                <p class="success-text">Schedule updated successfully.</p>
            }

            <hr style="margin: 20px 0;" />

            <h4>Current Availability</h4>

            @if (!availabilitySlots.Any())
            {
                <p>No availability slots added yet.</p>
            }
            else
            {
                @foreach (var slot in availabilitySlots)
                {
                    <div class="pill-row" style="margin-bottom:10px;">
                        <span>
                            @slot.AvailableDateTime.ToString("ddd dd/MM/yyyy HH:mm")
                            @(slot.IsTaken ? " - Booked" : " - Available")
                        </span>

                        @if (!slot.IsTaken)
                        {
                            <button type="button"
                                    class="pill-btn"
                                    @onclick="() => RemoveAvailabilitySlot(slot.AvailabilityId)">
                                Remove
                            </button>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    string? errorMessage;
    bool isLoading = true;
    bool instructorScheduleSaved = false;

    DateTime? selectedDate;

    List<string> instructorAvailableTimes = new()
    {
        "08:00", "09:00", "10:00", "11:00",
        "12:00", "13:00", "14:00", "15:00", "16:00"
    };

    List<string> instructorSelectedTimes = new();

    List<InstructorAvailabilityDto> availabilitySlots = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadAvailabilitySlots();
        StateHasChanged();
    }

    void InstructorSelectTime(string instructorTime)
    {
        instructorScheduleSaved = false;

        if (instructorSelectedTimes.Contains(instructorTime))
            instructorSelectedTimes.Remove(instructorTime);
        else if (instructorSelectedTimes.Count < 5)
            instructorSelectedTimes.Add(instructorTime);
    }

    private async Task LoadAvailabilitySlots()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/availability/instructor/my-slots");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "failed to load availability slots";
                isLoading = false;
                return;
            }

            var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<InstructorAvailabilityDto>>>();

            if (result == null || !result.Success || result.Data == null)
            {
                errorMessage = "could not read availability slots";
                isLoading = false;
                return;
            }

            availabilitySlots = result.Data;
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading schedule settings";
            isLoading = false;
        }
    }

    private async Task InstructorSaveSchedule()
    {
        errorMessage = null;
        instructorScheduleSaved = false;

        if (!selectedDate.HasValue)
        {
            errorMessage = "please choose a date";
            return;
        }

        if (!instructorSelectedTimes.Any())
        {
            errorMessage = "please choose at least one time slot";
            return;
        }

        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "you are not logged in";
            Nav.NavigateTo("/login?role=instructor");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        foreach (var selectedTime in instructorSelectedTimes)
        {
            if (!TimeSpan.TryParse(selectedTime, out var parsedTime))
            {
                errorMessage = $"invalid time selected: {selectedTime}";
                return;
            }

            var slotDateTime = selectedDate.Value.Date.Add(parsedTime);

            var request = new CreateAvailabilitySlotRequest
            {
                AvailableDateTime = slotDateTime
            };

            var response = await Http.PostAsJsonAsync("api/availability/instructor/my-slots", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorAvailabilityDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? $"could not save slot {selectedTime}";
                return;
            }
        }

        instructorScheduleSaved = true;
        instructorSelectedTimes.Clear();
        selectedDate = null;

        await LoadAvailabilitySlots();
    }

    private async Task RemoveAvailabilitySlot(int availabilityId)
    {
        errorMessage = null;
        instructorScheduleSaved = false;

        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            errorMessage = "you are not logged in";
            Nav.NavigateTo("/login?role=instructor");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        var response = await Http.DeleteAsync($"api/availability/instructor/my-slots/{availabilityId}");
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        if (!response.IsSuccessStatusCode || result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "could not remove availability slot";
            return;
        }

        instructorScheduleSaved = true;
        await LoadAvailabilitySlots();
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class CreateAvailabilitySlotRequest
    {
        public DateTime AvailableDateTime { get; set; }
    }

    public class InstructorAvailabilityDto
    {
        public int AvailabilityId { get; set; }
        public int InstructorId { get; set; }
        public DateTime AvailableDateTime { get; set; }
        public bool IsTaken { get; set; }
    }
}