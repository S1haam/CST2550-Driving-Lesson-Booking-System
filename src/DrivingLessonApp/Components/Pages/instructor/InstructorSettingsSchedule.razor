@page "/instructor-settings-schedule"
@rendermode InteractiveServer
@inject NavigationManager Nav

<!-- BRAND TITLE -->
<div class="brand-title">SER Driving School</div>

<h3>Settings: Schedule Information</h3>

<div class="row">

    <!-- SIDEBAR -->
    <div class="col-md-3 py-4 px-3">
        <div class="card shadow-sm">
            <input type="checkbox" id="settingsDropdown" class="dropdown-toggle" />

            <div class="card-body">
                <h2 class="fw-semibold mb-4">Settings</h2>

                <!-- Dropdown menu -->
                <div class="dropdown-container">
                    <label for="settingsDropdown" class="dropdown-btn">
                        Options
                        <span class="arrow">▾</span>
                    </label>
                   <div class="instructor-settings-options">
    <button @onclick='() => Nav.NavigateTo("/instructor-settings-schedule")'>
        Schedule Information
    </button>

    <button @onclick='() => Nav.NavigateTo("/instructor-settings-account")'>
        Account Information
    </button>

    <button @onclick='() => Nav.NavigateTo("/instructor-settings-status")'>
        Status
    </button>
</div>
                   
                </div>

                <!-- Log Out -->
                <button class="btn btn-danger text-white w-100 mt-5">
                    Log Out
                </button>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="col-md-9 py-4 px-3">
        <div class="card shadow-sm">
            <div class="card-body mb-5">

                <h2 class="fw-semibold mb-4">Schedule Information</h2>
                <h4 class="fw-semibold">Change Class Times</h4>
                <p class="mb-2">What times would you like to change to?</p>
                <p class="text-muted">Pick 5 available time slots:</p>
                <p class="text-muted">
                    Currently you have @string.Join(", ", currentTimes)
                </p>

                <!-- Options -->
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var time in availableTimes)
                    {
                        <button class="btn btn-outline-primary"
                                @onclick="() => SelectTime(time)">
                            @time
                        </button>
                    }
                </div>

                <!-- Save Changes -->
                <div class="mt-4">
                    <button class="btn btn-success" @onclick="SaveChanges">Save Changes</button>
                </div>

            </div>
        </div>
    </div>
</div>

@code {
    // Currently booked times
    List<string> currentTimes = new() { "12:00pm", "1:00pm", "2:00pm", "3:00pm", "4:00pm" };

    // Available times for selection
    List<string> availableTimes = new()
    {
        "8:00am", "9:00am", "10:00am", "11:00am", "12:00pm",
        "1:00pm", "2:00pm", "3:00pm", "4:00pm"
    };

    // Selected times
    List<string> selectedTimes = new();

    void SelectTime(string time)
    {
        if (selectedTimes.Contains(time))
            selectedTimes.Remove(time);
        else if (selectedTimes.Count < 5)
            selectedTimes.Add(time);
    }

    void SaveChanges()
    {
        // Simulate save and navigate to success page
        Nav.NavigateTo("/instructor-settings-success");
    }
}