@page "/instructor-schedule"
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>My Schedule</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<div class="card next-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">

        <div class="tabs">
            <div class="tab @(instructorShowNext ? "active" : "")"
                 @onclick='() => { instructorShowNext = true; instructorSearchResult = null; }'>
                Next Lessons
            </div>

            <div class="tab @(!instructorShowNext ? "active" : "")"
                 @onclick='() => { instructorShowNext = false; instructorSearchResult = null; }'>
                Previous Lessons
            </div>
        </div>

        <div class="search-container">
            <input @bind="instructorSearchId" placeholder="Search by ID" />
            <button @onclick="InstructorSearchBooking">Search</button>
        </div>

    </div>

    <div class="lesson-list">

        @if (instructorSearchResult != null)
        {
            <div class="lesson-item">
                <span>@instructorSearchResult.Date @instructorSearchResult.Time</span>

                @if (instructorSearchResult.IsNextLesson)
                {
                    <div>
                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo("/instructor-lesson-details?type=next")'>
                            VIEW
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo("/instructor-cancel-booking")'>
                            CANCEL
                        </button>
                    </div>
                }
                else
                {
                    <button class="schedule-action-btn"
                            @onclick='() => Nav.NavigateTo("/instructor-lesson-details?type=previous")'>
                        VIEW
                    </button>
                }
            </div>
        }
        else if (instructorShowNext)
        {
            @foreach (var instructorLesson in instructorNextLessons)
            {
                <div class="lesson-item">
                    <span>@instructorLesson.Date @instructorLesson.Time</span>
                    <div>
                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo("/instructor-lesson-details?type=next")'>
                            VIEW
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo("/instructor-cancel-booking")'>
                            CANCEL
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach (var instructorLesson in instructorPreviousLessons)
            {
                <div class="lesson-item">
                    <span>@instructorLesson.Date @instructorLesson.Time</span>
                    <button class="schedule-action-btn"
                            @onclick='() => Nav.NavigateTo("/instructor-lesson-details?type=previous")'>
                        VIEW
                    </button>
                </div>
            }
        }

    </div>

</div>

@code {
    bool instructorShowNext = true;

    string? instructorSearchId;

    InstructorLesson? instructorSearchResult;

    protected override void OnInitialized()
    {
        var instructorUri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(instructorUri.Query).TryGetValue("tab", out var instructorTab))
        {
            instructorShowNext = instructorTab == "next";
        }
    }

    List<InstructorLesson> instructorNextLessons = new()
    {
        new InstructorLesson { Id = 12340586, Date = "15/08/2025", Time = "12:00-14:00", IsNextLesson = true },
        new InstructorLesson { Id = 12340587, Date = "17/08/2025", Time = "15:00-18:00", IsNextLesson = true }
    };

    List<InstructorLesson> instructorPreviousLessons = new()
    {
        new InstructorLesson { Id = 12342386, Date = "02/08/2025", Time = "13:00-15:00", IsNextLesson = false }
    };

    void InstructorSearchBooking()
    {
        instructorSearchResult = null;

        foreach (var instructorLesson in instructorNextLessons)
        {
            if (instructorLesson.Id.ToString() == instructorSearchId)
            {
                instructorSearchResult = instructorLesson;
                return;
            }
        }

        foreach (var instructorLesson in instructorPreviousLessons)
        {
            if (instructorLesson.Id.ToString() == instructorSearchId)
            {
                instructorSearchResult = instructorLesson;
                return;
            }
        }
    }

    class InstructorLesson
    {
        public int Id { get; set; }
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public bool IsNextLesson { get; set; }
    }
}