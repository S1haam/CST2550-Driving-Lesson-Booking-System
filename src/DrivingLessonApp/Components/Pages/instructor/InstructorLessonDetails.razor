@page "/instructor-lesson-details"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<div class="brand-title">SER Driving School</div>

<h3>Lesson Details</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<div class="instructor-lesson-outer-card @(instructorIsNext ? "" : "secondary")">

    <div class="instructor-lesson-section-label">@instructorLessonTypeText</div>

    <div class="instructor-lesson-inner-card">
        <div class="instructor-lesson-info-row">

            <div class="instructor-lesson-info-box">
                <span>ID</span>
                <strong>12342386</strong>
            </div>

            <div class="instructor-lesson-info-box">
                <span>Student</span>
                <strong>David</strong>
            </div>

            <div class="instructor-lesson-info-box">
                <span>Date</span>
                <strong>02/08/2025</strong>
            </div>

            <div class="instructor-lesson-info-box">
                <span>Time</span>
                <strong>13:00-15:00</strong>
            </div>

        </div>
    </div>
</div>

<div class="instructor-lesson-notes-card @(instructorIsNext ? "instructor-lesson-notes-blue" : "")">

    <div class="instructor-lesson-notes-title">Instructor Notes</div>

    <div class="instructor-lesson-notes-content">
        <textarea class="instructor-notes-input"
                  @bind="instructorNotesText"
                  placeholder="Enter instructor notes here..."></textarea>

        <button class="instructor-settings-save" @onclick="InstructorSaveNotes">
            Save Notes
        </button>

        @if (instructorNotesSaved)
        {
            <p class="success-text">Notes saved successfully.</p>
        }
    </div>

</div>

@code {
    string instructorLessonTypeText = "Previous Lesson";
    bool instructorIsNext = false;

    string instructorNotesText = "Student should improve clutch control and mirror checks.";
    bool instructorNotesSaved = false;

    protected override void OnInitialized()
    {
        var instructorUri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(instructorUri.Query).TryGetValue("type", out var instructorType))
        {
            if (instructorType == "next")
            {
                instructorLessonTypeText = "Next Lesson";
                instructorIsNext = true;
            }
        }
    }

    void InstructorSaveNotes()
    {
        instructorNotesSaved = true;
    }
}