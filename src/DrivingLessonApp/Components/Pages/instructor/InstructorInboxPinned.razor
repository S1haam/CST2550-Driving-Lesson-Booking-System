@page "/instructor-inbox-pinned"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Pinned Notifications</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
</div>

<div class="instructor-inbox-card">

    @foreach (var item in pinnedNotifications)
    {
        <div class="instructor-inbox-item">

            <div>
                <strong>@item.Title</strong>
                <div class="instructor-inbox-meta">
                    @item.Time • @item.Date
                </div>
            </div>

            <button class="instructor-inbox-btn small"
                    @onclick='() => Nav.NavigateTo("/instructor-request")'>
                View
            </button>

        </div>
    }

</div>

@code {
    class NotificationItem
    {
        public string Title { get; set; } = "";
        public string Time { get; set; } = "";
        public string Date { get; set; } = "";
    }

    List<NotificationItem> pinnedNotifications = new()
    {
        new() { Title = "Booking Request", Time = "10:15", Date = "10 Jan 2026" },
        new() { Title = "Rescheduled Lesson", Time = "10:15", Date = "10 Jan 2026" }
    };
}