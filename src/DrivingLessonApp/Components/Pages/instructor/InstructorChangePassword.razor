@page "/instructor-change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Change Password</h3>

<div class="booking-card">

    <h1>Change Password</h1>

    <input type="password"
           placeholder="Current Password"
           @bind="currentPassword" />

    <input type="password"
           placeholder="New Password"
           @bind="newPassword" />

    <input type="password"
           placeholder="Confirm New Password"
           @bind="confirmPassword" />

    <button class="booking-btn"
            @onclick="UpdatePassword">
        Update Password
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/instructor-settings-account")'>
        Back
    </button>

    @if (passwordChanged)
    {
        <p class="success-text">Password changed successfully. Redirecting to start page...</p>
    }

</div>

@code {
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    bool passwordChanged = false;

    async Task UpdatePassword()
    {
        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            return;
        }

        if (newPassword != confirmPassword)
        {
            return;
        }

        passwordChanged = true;

        await Task.Delay(2000);

        Nav.NavigateTo("/");
    }
}