@page "/instructor-change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Change Password</h3>

<div class="booking-card">

    <input type="password"
           placeholder="New Password..."
           @bind="newPassword" />

    <input type="password"
           placeholder="Confirm with Old Password..."
           @bind="oldPassword" />

    <button class="booking-btn" @onclick="Save">Save Password</button>

</div>

@code {
    string newPassword;
    string oldPassword;

    void Save()
    {
        Nav.NavigateTo("/instructor-settings-success");
    }
}