@page "/instructor-change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Change Password</h3>

<div class="booking-card">

    <h1>Change Password</h1>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input type="password"
           placeholder="Current Password"
           @bind="currentPassword" />

    <input type="password"
           placeholder="New Password"
           @bind="newPassword" />

    <input type="password"
           placeholder="Confirm New Password"
           @bind="confirmPassword" />

    <button class="booking-btn"
            @onclick="UpdatePassword"
            disabled="@isSubmitting">
        @(isSubmitting ? "Updating..." : "Update Password")
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/instructor-settings-account")'>
        Back
    </button>

    @if (passwordChanged)
    {
        <p class="success-text">
            Password changed successfully. Redirecting to login...
        </p>
    }

</div>

@code {
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    bool passwordChanged = false;
    bool isSubmitting = false;
    string? errorMessage;

    async Task UpdatePassword()
    {
        if (isSubmitting) return;

        errorMessage = null;
        passwordChanged = false;

        var current = currentPassword?.Trim() ?? "";
        var newPass = newPassword?.Trim() ?? "";
        var confirm = confirmPassword?.Trim() ?? "";

        // required fields
        if (string.IsNullOrWhiteSpace(current) ||
            string.IsNullOrWhiteSpace(newPass) ||
            string.IsNullOrWhiteSpace(confirm))
        {
            errorMessage = "Please fill in all password fields.";
            return;
        }

        // strong validation (same as backend)
        if (!IsValidPassword(newPass))
        {
            errorMessage = "Password must be at least 6 characters, include one uppercase letter and one number.";
            return;
        }

        // match
        if (newPass != confirm)
        {
            errorMessage = "New passwords do not match.";
            return;
        }

        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/login?role=instructor");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        isSubmitting = true;

        try
        {
            var request = new ChangePasswordRequest
            {
                CurrentPassword = current,
                NewPassword = newPass,
                ConfirmPassword = confirm
            };

            var response = await Http.PutAsJsonAsync("api/instructor/change-password", request);
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "Could not change password.";
                isSubmitting = false;
                return;
            }

            passwordChanged = true;

            // logout
            await JS.InvokeVoidAsync("sessionStorage.clear");

            await Task.Delay(2000);

            Nav.NavigateTo("/login?role=instructor");
        }
        catch
        {
            errorMessage = "Something went wrong while updating password.";
            isSubmitting = false;
        }
    }

    // SAME RULES AS BACKEND
    bool IsValidPassword(string password)
    {
        return password.Length >= 6 &&
               password.Any(char.IsUpper) &&
               password.Any(char.IsDigit);
    }

    public class ChangePasswordRequest
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}