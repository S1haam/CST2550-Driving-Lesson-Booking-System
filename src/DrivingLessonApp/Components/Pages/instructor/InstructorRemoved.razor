@page "/instructor-removed/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Student Removed</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading student details...</p>
}
else
{
    <div class="instructor-student-card">

        <h2>@studentName</h2>

        <p>
            Student has been removed from your list.
            They will need to choose another instructor before booking again.
        </p>

        <button class="booking-btn"
                @onclick='() => Nav.NavigateTo("/instructorHome")'>
            Back to Home
        </button>

    </div>
}

@code {
    [Parameter] public int id { get; set; }

    string? errorMessage;
    bool isLoading = true;
    string studentName = "Student";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadRemovedStudentName();
        StateHasChanged();
    }

    // this tries to load the learner name for display after removal
    private async Task LoadRemovedStudentName()
    {
        try
        {
            if (id <= 0)
            {
                errorMessage = "invalid student id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                studentName = "Student";
                isLoading = false;
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/learner/{id}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<LearnerDto>>();

            if (response.IsSuccessStatusCode && result != null && result.Success && result.Data != null)
            {
                studentName = result.Data.LearnerName;
            }

            isLoading = false;
        }
        catch
        {
            studentName = "Student";
            isLoading = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class LearnerDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
    }
}