@page "/instructor-request"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Booking Request</h3>

<div class="instructor-message-card">

    <h2>Booking Request</h2>

    <p>
        A student would like to book a lesson on Monday at 12:00pm.
        Does this align with your schedule?
    </p>

    <div class="instructor-confirm-actions">

        <button class="instructor-success-btn"
                @onclick='() => Nav.NavigateTo("/instructor-confirm-yes")'>
            Yes
        </button>

        <button class="instructor-danger-btn"
                @onclick='() => Nav.NavigateTo("/instructor-confirm-no")'>
            No
        </button>

    </div>

</div>