@page "/instructor-remove-confirm/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Confirm Removal</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading student details...</p>
}
else
{
    <div class="instructor-student-card">

        <h2>@studentName</h2>

        <p>
            Are you sure you want to remove this student?
        </p>

        <div class="instructor-confirm-actions">

            <button class="instructor-success-btn"
                    disabled="@isSubmitting"
                    @onclick="RemoveStudent">
                @(isSubmitting ? "Removing..." : "Yes")
            </button>

            <button class="instructor-danger-btn"
                    disabled="@isSubmitting"
                    @onclick='() => Nav.NavigateTo($"/instructor-learner/{id}")'>
                No
            </button>

        </div>

    </div>
}

@code {
    [Parameter] public int id { get; set; }

    string? errorMessage;
    bool isLoading = true;
    bool isSubmitting = false;
    string studentName = "Student";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadStudentDetails();
        StateHasChanged();
    }

    // this loads the selected learner before confirming removal
    private async Task LoadStudentDetails()
    {
        try
        {
            if (id <= 0)
            {
                errorMessage = "invalid student id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/instructor/learner/{id}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<InstructorLearnerDetailsDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "failed to load student details";
                isLoading = false;
                return;
            }

            studentName = result.Data.LearnerName;
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading student details";
            isLoading = false;
        }
    }

    // this sends the remove request to the backend
    private async Task RemoveStudent()
    {
        if (isSubmitting)
            return;

        isSubmitting = true;
        errorMessage = null;

        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=instructor");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.PutAsJsonAsync($"api/instructor/learner/{id}/remove", new { });
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success)
            {
                errorMessage = result?.Message ?? "failed to remove student";
                isSubmitting = false;
                return;
            }

            Nav.NavigateTo($"/instructor-removed/{id}");
        }
        catch
        {
            errorMessage = "something went wrong while removing the student";
            isSubmitting = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class InstructorLearnerDetailsDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string LearnerLicenceId { get; set; } = "";
        public string LearnerEmail { get; set; } = "";
        public string LearnerPhone { get; set; } = "";
        public string LearnerStatus { get; set; } = "";
        public int PastLessonCount { get; set; }
        public int NextLessonCount { get; set; }
    }
}