@page "/change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav

<h3>Change Password</h3>

<!-- nav bar -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Change Password</h1>

    <!-- current password -->
    <input type="password"
           placeholder="Current Password"
           @bind="currentPassword" />

    <!-- new password -->
    <input type="password"
           placeholder="New Password"
           @bind="newPassword" />

    <!-- confirm password -->
    <input type="password"
           placeholder="Confirm New Password"
           @bind="confirmPassword" />

    <!-- update button -->
    <button class="booking-btn"
            @onclick="UpdatePassword">
        Update Password
    </button>

    <!-- back -->
    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/settings")'>
        Back
    </button>

</div>

@code {
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    // handles password update
    void UpdatePassword()
    {
        // simple validation
        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            return;
        }

        if (newPassword != confirmPassword)
        {
            return;
        }

        // simulate success → go back to settings
        Nav.NavigateTo("/settings");
    }
}