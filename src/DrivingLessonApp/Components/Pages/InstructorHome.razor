@page "/instructorHome"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Instructor Home</h3>

<!-- NAV BAR -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<!-- MAIN PANEL -->
<div class="instructor-home-panel">

    <p class="welcome-text">Welcome Instructor,</p>

    <div class="notif-bar">
        <span>You have 2 new notifications</span>
        <button class="notif-btn"
                @onclick='() => Nav.NavigateTo("/instructor-inbox")'>
            Check Inbox
        </button>
    </div>

    <div class="status-row">
        <span class="status-dot"></span>
        <span>Active</span>
    </div>

    <div class="home-grid">

        <!-- UPCOMING LESSONS -->
        <div class="home-card">
            <div class="card-title">Upcoming lessons</div>

            @foreach (var instructorLesson in instructorLessons)
            {
                <div class="pill-row">
                    <span>@instructorLesson.DisplayText</span>
                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-lesson-details?id={instructorLesson.Id}&type=next")'>
                        View
                    </button>
                </div>
            }
        </div>

        <!-- STUDENTS -->
        <div class="home-card">
            <div class="student-header-row">
    <div class="card-title student-card-title">Students</div>

    <div class="search-container student-search-container">
        <input @bind="instructorStudentSearch"
               placeholder="Search by ID" />
        <button type="button">Search</button>
    </div>
</div>

            @{
                var filteredInstructorStudents = FilteredInstructorStudents();
            }

            @foreach (var instructorStudent in filteredInstructorStudents)
            {
                <div class="pill-row">
                    <div class="student-left">
                        <div class="avatar-circle">@instructorStudent.Initials</div>
                        <span>@instructorStudent.Name</span>
                    </div>

                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-student?id={instructorStudent.Id}")'>
                        View
                    </button>
                </div>
            }

            @if (!filteredInstructorStudents.Any())
            {
                <p>No students found.</p>
            }

        </div>

    </div>

</div>

@code {
    string instructorStudentSearch = "";

    List<InstructorHomeLesson> instructorLessons = new()
    {
        new InstructorHomeLesson { Id = 12340586, DisplayText = "MON, 01/12/25, 1:00" },
        new InstructorHomeLesson { Id = 12340587, DisplayText = "TUE, 02/12/25, 2:00" },
        new InstructorHomeLesson { Id = 12340588, DisplayText = "WED, 03/12/25, 3:00" },
        new InstructorHomeLesson { Id = 12340589, DisplayText = "THU, 04/12/25, 4:00" }
    };

    List<InstructorHomeStudent> instructorStudents = new()
    {
        new InstructorHomeStudent { Id = 1001, Name = "Alice Evans", Initials = "AE" },
        new InstructorHomeStudent { Id = 1002, Name = "John Smith", Initials = "JS" },
        new InstructorHomeStudent { Id = 1003, Name = "David Lee", Initials = "DL" },
        new InstructorHomeStudent { Id = 1004, Name = "Sarah Khan", Initials = "SK" }
    };

    List<InstructorHomeStudent> FilteredInstructorStudents()
    {
        if (string.IsNullOrWhiteSpace(instructorStudentSearch))
            return instructorStudents;

        return instructorStudents
            .Where(instructorStudent =>
                instructorStudent.Name.Contains(instructorStudentSearch, StringComparison.OrdinalIgnoreCase)
                || instructorStudent.Id.ToString().Contains(instructorStudentSearch))
            .ToList();
    }

    class InstructorHomeLesson
    {
        public int Id { get; set; }
        public string DisplayText { get; set; } = "";
    }

    class InstructorHomeStudent
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Initials { get; set; } = "";
    }
}