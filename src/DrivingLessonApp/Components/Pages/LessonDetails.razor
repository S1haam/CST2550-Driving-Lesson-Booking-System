@page "/lesson-details"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Lesson Details</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<!-- lesson info -->
<div class="outer-card secondary">

    <div class="section-label">Previous Lesson</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>12342386</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>David</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>02/08/2025</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>13:00-15:00</strong>
            </div>

        </div>
    </div>
</div>

<!-- instructor notes -->
<div class="notes-card">

    <div class="notes-title">Instructor Notes</div>

    <div class="notes-content">
        Driver should improve clutch control and mirror checks.
    </div>

</div>