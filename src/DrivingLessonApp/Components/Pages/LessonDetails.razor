@page "/lesson-details"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="brand-title">SER Driving School</div>

<h3>Lesson Details</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button>Book lessons</button>
    <button>FAQs</button>
    <button>Settings</button>
</div>

<div class="card previous-card">

    <div class="section-title">Previous Lesson</div>

    <div class="lesson-pill-container">
        <div class="lesson-pill">ID<br />12342386</div>
        <div class="lesson-pill">Driver<br />David</div>
        <div class="lesson-pill">Date<br />02/08/2025</div>
        <div class="lesson-pill">Time<br />13:00 - 15:00</div>
    </div>

</div>

<div class="card">

    <div class="section-title">Instructor Notes</div>

    <!-- readonly notes (student cannot edit) -->
    <div class="lesson-list">
        driver should improve clutch control and mirror checks.
    </div>

</div>