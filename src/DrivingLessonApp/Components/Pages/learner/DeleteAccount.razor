@page "/delete-account"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Delete Account</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Delete Account</h1>

    <p class="delete-warning">
        Deleting your account is permanent. All your data, bookings, and personal information will be removed.
        This action cannot be undone.
    </p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input type="password"
           placeholder="Enter your password to confirm"
           @bind="password" />

    <input placeholder="Type DELETE to confirm"
           @bind="confirmText" />

    <button class="delete-btn full @(CanDelete ? "" : "inactive")"
            @onclick="HandleDelete"
            disabled="@isSubmitting">
        @(isSubmitting ? "Deleting..." : "Delete My Account")
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/settings")'>
        Back
    </button>

</div>

@code {
    string? password;
    string? confirmText;
    string? errorMessage;
    bool isSubmitting;

    // this checks whether the delete form is complete
    bool CanDelete =>
        confirmText == "DELETE" &&
        !string.IsNullOrWhiteSpace(password);

    // this sends the delete account request to the backend
    async Task HandleDelete()
    {
        errorMessage = null;

        if (!CanDelete)
        {
            errorMessage = "Enter your password and type DELETE to confirm.";
            return;
        }

        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/login?role=learner");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        isSubmitting = true;

        var request = new DeleteLearnerRequest
        {
            Password = password?.Trim() ?? "",
            ConfirmText = confirmText?.Trim() ?? ""
        };

        var httpRequest = new HttpRequestMessage(HttpMethod.Delete, "api/learner/delete")
        {
            Content = JsonContent.Create(request)
        };

        var response = await Http.SendAsync(httpRequest);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        isSubmitting = false;

        if (!response.IsSuccessStatusCode || result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "Could not delete account.";
            return;
        }

        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userEmail");

        Nav.NavigateTo("/delete-success");
    }

    public class DeleteLearnerRequest
    {
        public string Password { get; set; } = "";
        public string ConfirmText { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}