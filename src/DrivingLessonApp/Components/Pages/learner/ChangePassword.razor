@page "/change-password"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Change Password</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Change Password</h1>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input type="password"
           placeholder="Current Password"
           @bind="currentPassword" />

    <input type="password"
           placeholder="New Password"
           @bind="newPassword" />

    <input type="password"
           placeholder="Confirm New Password"
           @bind="confirmPassword" />

    <button class="booking-btn"
            @onclick="UpdatePassword"
            disabled="@isSubmitting">
        @(isSubmitting ? "Updating..." : "Update Password")
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/settings")'>
        Back
    </button>

    @if (passwordChanged)
    {
        <p class="success-text">Password changed successfully. Redirecting to start page...</p>
    }

</div>

@code {
    string? currentPassword;
    string? newPassword;
    string? confirmPassword;

    bool passwordChanged = false;
    bool isSubmitting = false;
    string? errorMessage;

    // this sends the password change request to the backend
    async Task UpdatePassword()
    {
        errorMessage = null;
        passwordChanged = false;

        var cleanCurrentPassword = currentPassword?.Trim() ?? "";
        var cleanNewPassword = newPassword?.Trim() ?? "";
        var cleanConfirmPassword = confirmPassword?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(cleanCurrentPassword) ||
            string.IsNullOrWhiteSpace(cleanNewPassword) ||
            string.IsNullOrWhiteSpace(cleanConfirmPassword))
        {
            errorMessage = "Please fill in all password fields.";
            return;
        }

        if (cleanNewPassword.Length < 6)
        {
            errorMessage = "New password must be at least 6 characters.";
            return;
        }

        if (cleanNewPassword != cleanConfirmPassword)
        {
            errorMessage = "New passwords do not match.";
            return;
        }

        var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/login?role=learner");
            return;
        }

        Http.DefaultRequestHeaders.Authorization =
            new AuthenticationHeaderValue("Bearer", token);

        isSubmitting = true;

        var request = new ChangePasswordRequest
        {
            CurrentPassword = cleanCurrentPassword,
            NewPassword = cleanNewPassword,
            ConfirmPassword = cleanConfirmPassword
        };

        var response = await Http.PutAsJsonAsync("api/learner/change-password", request);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        isSubmitting = false;

        if (!response.IsSuccessStatusCode || result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "Could not change password.";
            return;
        }

        passwordChanged = true;

        await JS.InvokeVoidAsync("sessionStorage.removeItem", "authToken");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userRole");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userId");
        await JS.InvokeVoidAsync("sessionStorage.removeItem", "userEmail");

        await Task.Delay(2000);

        Nav.NavigateTo("/login?role=learner");
    }

    public class ChangePasswordRequest
    {
        public string CurrentPassword { get; set; } = "";
        public string NewPassword { get; set; } = "";
        public string ConfirmPassword { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}