@page "/schedule"
@using Microsoft.AspNetCore.WebUtilities
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>My Schedule</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="card next-card">

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">

        <div class="tabs">
            <div class="tab @(showNext ? "active" : "")"
                 @onclick='() => { showNext = true; searchResult = null; searchMessage = null; }'>
                Next Lessons
            </div>

            <div class="tab @(!showNext ? "active" : "")"
                 @onclick='() => { showNext = false; searchResult = null; searchMessage = null; }'>
                Previous Lessons
            </div>
        </div>

        <div class="search-container">
            <input @bind="searchId" placeholder="Search by ID" />
            <button @onclick="SearchBooking">Search</button>
        </div>

    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading schedule...</p>
    }

    @if (!string.IsNullOrWhiteSpace(searchMessage))
    {
        <p style="color:red; margin-bottom:10px;">@searchMessage</p>
    }

    <div class="lesson-list">

        @if (searchResult != null)
        {
            <div class="lesson-item">
                <span>@searchResult.Date @searchResult.Time</span>

                @if (searchResult.IsNextLesson)
                {
                    <div>
                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/lesson-details?bookingId={searchResult.Id}&type=next")'>
                            VIEW
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/reschedule-booking?bookingId={searchResult.Id}")'>
                            RESCHEDULE
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/cancel-booking?bookingId={searchResult.Id}")'>
                            CANCEL
                        </button>
                    </div>
                }
                else
                {
                    <button class="schedule-action-btn"
                            @onclick='() => Nav.NavigateTo($"/lesson-details?bookingId={searchResult.Id}&type=previous")'>
                        VIEW
                    </button>
                }
            </div>
        }
        else if (showNext)
        {
            @foreach (var lesson in nextLessons)
            {
                <div class="lesson-item">
                    <span>@lesson.Date @lesson.Time</span>
                    <div>
                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/lesson-details?bookingId={lesson.Id}&type=next")'>
                            VIEW
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/reschedule-booking?bookingId={lesson.Id}")'>
                            RESCHEDULE
                        </button>

                        <button class="schedule-action-btn"
                                @onclick='() => Nav.NavigateTo($"/cancel-booking?bookingId={lesson.Id}")'>
                            CANCEL
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            @foreach (var lesson in previousLessons)
            {
                <div class="lesson-item">
                    <span>@lesson.Date @lesson.Time</span>
                    <button class="schedule-action-btn"
                            @onclick='() => Nav.NavigateTo($"/lesson-details?bookingId={lesson.Id}&type=previous")'>
                        VIEW
                    </button>
                </div>
            }
        }

    </div>

</div>

@code {
    bool showNext = true;
    bool isLoading = true;
    string? searchId;
    string? errorMessage;
    string? searchMessage;

    Lesson? searchResult;

    List<Lesson> nextLessons = new();
    List<Lesson> previousLessons = new();

    // this runs when the page first loads
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("tab", out var tab))
        {
            showNext = tab == "next";
        }

        await LoadSchedule();
        StateHasChanged();
    }

    // this loads upcoming and past bookings for the logged in learner
    async Task LoadSchedule()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var upcomingResponse = await Http.GetAsync("api/booking/learner/upcoming");
            var upcomingResult = await upcomingResponse.Content.ReadFromJsonAsync<ApiResponse<List<BookingResponseDto>>>();

            if (!upcomingResponse.IsSuccessStatusCode || upcomingResult == null || !upcomingResult.Success || upcomingResult.Data == null)
            {
                errorMessage = upcomingResult?.Message ?? "could not load upcoming lessons.";
                isLoading = false;
                return;
            }

            var pastResponse = await Http.GetAsync("api/booking/learner/past");
            var pastResult = await pastResponse.Content.ReadFromJsonAsync<ApiResponse<List<BookingResponseDto>>>();

            if (!pastResponse.IsSuccessStatusCode || pastResult == null || !pastResult.Success || pastResult.Data == null)
            {
                errorMessage = pastResult?.Message ?? "could not load previous lessons.";
                isLoading = false;
                return;
            }

            nextLessons = upcomingResult.Data
                .Select(x => new Lesson
                {
                    Id = x.BookingId,
                    Date = x.LessonDate.ToString("dd/MM/yyyy"),
                    Time = x.LessonTime.ToString(@"hh\:mm"),
                    IsNextLesson = true
                })
                .ToList();

            previousLessons = pastResult.Data
                .Select(x => new Lesson
                {
                    Id = x.BookingId,
                    Date = x.LessonDate.ToString("dd/MM/yyyy"),
                    Time = x.LessonTime.ToString(@"hh\:mm"),
                    IsNextLesson = false
                })
                .ToList();

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading your schedule.";
            isLoading = false;
        }
    }

    // this searches real bookings by booking id
    void SearchBooking()
    {
        searchResult = null;
        searchMessage = null;

        if (string.IsNullOrWhiteSpace(searchId))
        {
            searchMessage = "please enter a booking id.";
            return;
        }

        var cleanSearchId = searchId.Trim();

        foreach (var lesson in nextLessons)
        {
            if (lesson.Id.ToString() == cleanSearchId)
            {
                searchResult = lesson;
                return;
            }
        }

        foreach (var lesson in previousLessons)
        {
            if (lesson.Id.ToString() == cleanSearchId)
            {
                searchResult = lesson;
                return;
            }
        }

        searchMessage = "no booking found with that id.";
    }

    class Lesson
    {
        public int Id { get; set; }
        public string Date { get; set; } = "";
        public string Time { get; set; } = "";
        public bool IsNextLesson { get; set; }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}