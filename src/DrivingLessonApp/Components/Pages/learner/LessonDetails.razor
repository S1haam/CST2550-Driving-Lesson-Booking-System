@page "/lesson-details"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

<h3>Lesson Details</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading lesson details...</p>
}
else
{
    <div class="outer-card @(isNext ? "" : "secondary")">

        <div class="section-label">@lessonTypeText</div>

        <div class="inner-card">
            <div class="info-row">

                <div class="info-box">
                    <span>ID</span>
                    <strong>@bookingId</strong>
                </div>

                <div class="info-box">
                    <span>Driver</span>
                    <strong>@instructorName</strong>
                </div>

                <div class="info-box">
                    <span>Date</span>
                    <strong>@lessonDate</strong>
                </div>

                <div class="info-box">
                    <span>Time</span>
                    <strong>@lessonTime</strong>
                </div>

            </div>
        </div>
    </div>

    <div class="notes-card @(isNext ? "notes-blue" : "")">

        <div class="notes-title">Instructor Notes</div>

        <div class="notes-content">
            @instructorNotes
        </div>

    </div>
}

<div style="text-align:center; margin-top:20px;">
    <button class="booking-back" @onclick="GoBackToSchedule">
        Go Back to My Schedule
    </button>
</div>

@code {
    string lessonTypeText = "Previous Lesson";
    bool isNext = false;
    string scheduleTab = "previous";

    string? errorMessage;
    bool isLoading = true;

    int bookingId = 0;
    string instructorName = "";
    string lessonDate = "";
    string lessonTime = "";
    string instructorNotes = "no instructor notes available yet.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("type", out var type))
        {
            if (type == "next")
            {
                lessonTypeText = "Next Lesson";
                isNext = true;
                scheduleTab = "next";
            }
        }

        if (query.TryGetValue("bookingId", out var bookingValue))
        {
            int.TryParse(bookingValue, out bookingId);
        }

        await LoadLessonDetails();
        StateHasChanged();
    }

    async Task LoadLessonDetails()
    {
        try
        {
            if (bookingId <= 0)
            {
                errorMessage = "invalid booking id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/booking/{bookingId}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<BookingResponseDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load lesson details.";
                isLoading = false;
                return;
            }

            var booking = result.Data;

            instructorName = booking.InstructorName;
            lessonDate = booking.LessonDate.ToString("dd/MM/yyyy");
            lessonTime = booking.LessonTime.ToString(@"hh\:mm");
            instructorNotes = string.IsNullOrWhiteSpace(booking.InstructorNotes)
                ? "no instructor notes available yet."
                : booking.InstructorNotes;

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading lesson details.";
            isLoading = false;
        }
    }

    void GoBackToSchedule()
    {
        Nav.NavigateTo($"/schedule?tab={scheduleTab}");
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public string? InstructorNotes { get; set; }
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}