@page "/lesson-details"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<div class="brand-title">SER Driving School</div>

<h3>Lesson Details</h3>

<!-- navigation bar -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<!-- lesson info -->
<div class="outer-card @(isNext ? "" : "secondary")">

    <div class="section-label">@lessonTypeText</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>12342386</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>David</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>02/08/2025</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>13:00-15:00</strong>
            </div>

        </div>
    </div>
</div>

<!-- notes section -->
<div class="notes-card @(isNext ? "notes-blue" : "")">

    <div class="notes-title">Instructor Notes</div>

    <div class="notes-content">
        Driver should improve clutch control and mirror checks.
    </div>

</div>

<!-- back to schedule -->
<div style="text-align:center; margin-top:20px;">
    <button class="booking-back" @onclick="GoBackToSchedule">
        Go Back to My Schedule
    </button>
</div>

@code {
    string lessonTypeText = "Previous Lesson";
    bool isNext = false;
    string scheduleTab = "previous";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("type", out var type))
        {
            if (type == "next")
            {
                lessonTypeText = "Next Lesson";
                isNext = true;
                scheduleTab = "next";
            }
        }
    }

    void GoBackToSchedule()
    {
        Nav.NavigateTo($"/schedule?tab={scheduleTab}");
    }
}