@page "/book-confirmed"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Booking Confirmed</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading booking details...</p>
    }
    else
    {
        <h1>Your booking has been confirmed!</h1>

        <div class="summary-box">

            <div class="summary-item">
                <strong>Booking ID:</strong> @bookingId
            </div>

            <div class="summary-item">
                <strong>Date:</strong> @selectedDate
            </div>

            <div class="summary-item">
                <strong>Time:</strong> @selectedTime
            </div>

            <div class="summary-item">
                <strong>Fee:</strong> £67
            </div>

        </div>

        <button class="booking-btn" @onclick='() => Nav.NavigateTo("/home")'>
            Return to home
        </button>

        <button class="booking-btn" @onclick='() => Nav.NavigateTo("/schedule")'>
            View booking
        </button>
    }

</div>

@code {
    string? errorMessage;
    bool isLoading = true;
    int bookingId = 0;
    string selectedDate = "";
    string selectedTime = "";

    // this runs when the page first loads and reads booking details
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("bookingId", out var bookingValue) ||
            !int.TryParse(bookingValue, out int parsedBookingId))
        {
            errorMessage = "invalid booking id.";
            isLoading = false;
            StateHasChanged();
            return;
        }

        bookingId = parsedBookingId;

        await LoadBooking();
        StateHasChanged();
    }

    // this loads all bookings and finds the one that was just confirmed
    async Task LoadBooking()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync("api/booking");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<BookingResponseDto>>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load booking details.";
                isLoading = false;
                return;
            }

            var booking = result.Data.FirstOrDefault(x => x.BookingId == bookingId);

            if (booking == null)
            {
                errorMessage = "booking not found.";
                isLoading = false;
                return;
            }

            selectedDate = booking.LessonDate.ToString("dd/MM/yyyy");
            selectedTime = booking.LessonTime.ToString(@"hh\:mm");
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading booking details.";
            isLoading = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}