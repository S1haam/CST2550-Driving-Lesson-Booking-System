@page "/reschedule-confirmed"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<h3>Reschedule Confirmed</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Your booking has been rescheduled!</h1>

    <div class="summary-box">

        <div class="summary-item">
            <strong>Booking ID:</strong> 12340586
        </div>

        <div class="summary-item">
            <strong>New Date:</strong> @selectedDate
        </div>

        <div class="summary-item">
            <strong>New Time:</strong> @selectedTime
        </div>

        <div class="summary-item">
            <strong>Fee:</strong> £0
        </div>

    </div>

    <button class="booking-btn" @onclick='() => Nav.NavigateTo("/home")'>
        Return to home
    </button>

    <button class="booking-btn" @onclick='() => Nav.NavigateTo("/schedule")'>
        View booking
    </button>

</div>

@code {
    string? selectedDate;
    string? selectedTime;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("date", out var dateValue))
        {
            selectedDate = dateValue;
        }

        if (query.TryGetValue("time", out var timeValue))
        {
            selectedTime = timeValue;
        }
    }
}