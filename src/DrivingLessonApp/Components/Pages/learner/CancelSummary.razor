@page "/cancel-summary"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Cancellation Summary</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Cancellation Summary</h1>

    <p>Please review your cancellation details:</p>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>loading cancellation summary...</p>
    }
    else
    {
        <div class="summary-box">

            <div class="summary-item">
                <strong>Date:</strong> @lessonDate
            </div>

            <div class="summary-item">
                <strong>Time:</strong> @lessonTime
            </div>

            <div class="summary-item">
                <strong>Refund:</strong> £67
            </div>

        </div>

        <button class="booking-back"
                @onclick='() => Nav.NavigateTo($"/cancel-booking?bookingId={bookingId}")'>
            Back
        </button>

        <button class="booking-btn"
                @onclick="ConfirmCancellation">
            Confirm cancellation
        </button>
    }

</div>

@code {
    int bookingId = 0;
    string lessonDate = "";
    string lessonTime = "";
    string? errorMessage;
    bool isLoading = true;

    // this runs when the page first loads and gets the selected booking id
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("bookingId", out var bookingValue))
        {
            int.TryParse(bookingValue, out bookingId);
        }

        await LoadBooking();
        StateHasChanged();
    }

    // this loads the selected booking from the backend
    async Task LoadBooking()
    {
        try
        {
            if (bookingId <= 0)
            {
                errorMessage = "invalid booking id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var response = await Http.GetAsync($"api/booking/{bookingId}");
            var result = await response.Content.ReadFromJsonAsync<ApiResponse<BookingResponseDto>>();

            if (!response.IsSuccessStatusCode || result == null || !result.Success || result.Data == null)
            {
                errorMessage = result?.Message ?? "could not load booking.";
                isLoading = false;
                return;
            }

            lessonDate = result.Data.LessonDate.ToString("dd/MM/yyyy");
            lessonTime = result.Data.LessonTime.ToString(@"hh\:mm");
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading booking.";
            isLoading = false;
        }
    }

    // this moves to the cancellation confirmed page with the booking id
    void ConfirmCancellation()
    {
        Nav.NavigateTo($"/cancel-confirmed?bookingId={bookingId}");
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}