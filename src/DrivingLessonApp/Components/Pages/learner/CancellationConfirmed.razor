@page "/cancel-confirmed"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<h3>Cancellation Confirmed</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }
    else if (isLoading)
    {
        <p>cancelling booking...</p>
    }
    else
    {
        <h1>Your booking has been cancelled</h1>

        <div class="summary-box">

            <div class="summary-item">
                <strong>Booking ID:</strong> @bookingId
            </div>

            <div class="summary-item">
                <strong>Date:</strong> @lessonDate
            </div>

            <div class="summary-item">
                <strong>Time:</strong> @lessonTime
            </div>

            <div class="summary-item">
                <strong>Refund Issued:</strong> £67
            </div>

        </div>

        <button class="booking-btn" @onclick='() => Nav.NavigateTo("/home")'>
            Return to home
        </button>

        <button class="booking-btn" @onclick='() => Nav.NavigateTo("/schedule")'>
            Back to schedule
        </button>
    }

</div>

@code {
    int bookingId = 0;
    string lessonDate = "";
    string lessonTime = "";
    string? errorMessage;
    bool isLoading = true;

    // this runs when the page first loads and cancels the selected booking
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("bookingId", out var bookingValue))
        {
            int.TryParse(bookingValue, out bookingId);
        }

        await CancelSelectedBooking();
        StateHasChanged();
    }

    // this sends the cancel request to the backend and then loads the cancelled booking details
    async Task CancelSelectedBooking()
    {
        try
        {
            if (bookingId <= 0)
            {
                errorMessage = "invalid booking id.";
                isLoading = false;
                return;
            }

            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            var cancelResponse = await Http.PutAsync($"api/booking/cancel/{bookingId}", null);
            var cancelResult = await cancelResponse.Content.ReadFromJsonAsync<ApiResponse<object>>();

            if (!cancelResponse.IsSuccessStatusCode || cancelResult == null || !cancelResult.Success)
            {
                errorMessage = cancelResult?.Message ?? "could not cancel booking.";
                isLoading = false;
                return;
            }

            var bookingResponse = await Http.GetAsync($"api/booking/{bookingId}");
            var bookingResult = await bookingResponse.Content.ReadFromJsonAsync<ApiResponse<BookingResponseDto>>();

            if (!bookingResponse.IsSuccessStatusCode || bookingResult == null || !bookingResult.Success || bookingResult.Data == null)
            {
                lessonDate = "";
                lessonTime = "";
                isLoading = false;
                return;
            }

            lessonDate = bookingResult.Data.LessonDate.ToString("dd/MM/yyyy");
            lessonTime = bookingResult.Data.LessonTime.ToString(@"hh\:mm");
            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while cancelling booking.";
            isLoading = false;
        }
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}