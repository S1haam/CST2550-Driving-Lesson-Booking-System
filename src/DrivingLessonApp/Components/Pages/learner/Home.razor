@page "/home"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http
@inject IJSRuntime JS

@using Microsoft.JSInterop
@using System.Net.Http.Headers
@using System.Net.Http.Json

<div class="brand-title">SER Driving School</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p style="color:red; margin-bottom:10px;">@errorMessage</p>
}
else if (isLoading)
{
    <p>loading learner profile...</p>
}
else
{
    <h3>Hello @learnerName!</h3>
}

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="outer-card">

    <div class="section-label">Next Lesson</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>@nextLessonIdText</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>@nextLessonInstructorText</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>@nextLessonDateText</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>@nextLessonTimeText</strong>
            </div>

            <button class="action-btn"
                    @onclick='() => Nav.NavigateTo("/schedule?tab=next")'>
                View All
            </button>

        </div>
    </div>
</div>

<div class="outer-card secondary">

    <div class="section-label">Previous Lesson</div>

    <div class="inner-card">
        <div class="info-row">

            <div class="info-box">
                <span>ID</span>
                <strong>@previousLessonIdText</strong>
            </div>

            <div class="info-box">
                <span>Driver</span>
                <strong>@previousLessonInstructorText</strong>
            </div>

            <div class="info-box">
                <span>Date</span>
                <strong>@previousLessonDateText</strong>
            </div>

            <div class="info-box">
                <span>Time</span>
                <strong>@previousLessonTimeText</strong>
            </div>

            <button class="action-btn"
                    @onclick='() => Nav.NavigateTo("/schedule?tab=previous")'>
                View All
            </button>

        </div>
    </div>
</div>

@code {
    string learnerName = "Learner";
    string instructorName = "Instructor";
    string? errorMessage;
    bool isLoading = true;

    string nextLessonIdText = "-";
    string nextLessonInstructorText = "-";
    string nextLessonDateText = "-";
    string nextLessonTimeText = "-";

    string previousLessonIdText = "-";
    string previousLessonInstructorText = "-";
    string previousLessonDateText = "-";
    string previousLessonTimeText = "-";

    // this runs when the page first loads
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        await LoadHomeData();
        StateHasChanged();
    }

    // this loads learner profile and booking summary data for the home page
    private async Task LoadHomeData()
    {
        try
        {
            var token = await JS.InvokeAsync<string>("sessionStorage.getItem", "authToken");

            if (string.IsNullOrWhiteSpace(token))
            {
                errorMessage = "you are not logged in";
                isLoading = false;
                Nav.NavigateTo("/login?role=learner");
                return;
            }

            Http.DefaultRequestHeaders.Authorization =
                new AuthenticationHeaderValue("Bearer", token);

            await LoadLearnerProfile();
            await LoadUpcomingBooking();
            await LoadPastBooking();

            isLoading = false;
        }
        catch
        {
            errorMessage = "something went wrong while loading your profile";
            isLoading = false;
        }
    }

    // this loads the logged in learner profile
    private async Task LoadLearnerProfile()
    {
        var response = await Http.GetAsync("api/learner/me");

        if (!response.IsSuccessStatusCode)
        {
            errorMessage = "failed to load learner profile";
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<LearnerResponseDto>>();

        if (result == null || !result.Success || result.Data == null)
        {
            errorMessage = "could not read learner profile";
            return;
        }

        learnerName = result.Data.LearnerName;
        instructorName = result.Data.InstructorName ?? "not assigned";
    }

    // this loads the first upcoming booking for the learner
    private async Task LoadUpcomingBooking()
    {
        var response = await Http.GetAsync("api/booking/learner/upcoming");

        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<BookingResponseDto>>>();

        if (result == null || !result.Success || result.Data == null || result.Data.Count == 0)
        {
            nextLessonInstructorText = instructorName;
            return;
        }

        var booking = result.Data.First();

        nextLessonIdText = booking.BookingId.ToString();
        nextLessonInstructorText = string.IsNullOrWhiteSpace(booking.InstructorName) ? instructorName : booking.InstructorName;
        nextLessonDateText = booking.LessonDate.ToString("dd/MM/yyyy");
        nextLessonTimeText = booking.LessonTime.ToString(@"hh\:mm");
    }

    // this loads the most recent past booking for the learner
    private async Task LoadPastBooking()
    {
        var response = await Http.GetAsync("api/booking/learner/past");

        if (!response.IsSuccessStatusCode)
        {
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<ApiResponse<List<BookingResponseDto>>>();

        if (result == null || !result.Success || result.Data == null || result.Data.Count == 0)
        {
            previousLessonInstructorText = instructorName;
            return;
        }

        var booking = result.Data.First();

        previousLessonIdText = booking.BookingId.ToString();
        previousLessonInstructorText = string.IsNullOrWhiteSpace(booking.InstructorName) ? instructorName : booking.InstructorName;
        previousLessonDateText = booking.LessonDate.ToString("dd/MM/yyyy");
        previousLessonTimeText = booking.LessonTime.ToString(@"hh\:mm");
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }

    public class LearnerResponseDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string LearnerLicenceId { get; set; } = "";
        public string LearnerEmail { get; set; } = "";
        public string LearnerPhone { get; set; } = "";
        public string LearnerStatus { get; set; } = "";
        public int PastLessonCount { get; set; }
        public int NextLessonCount { get; set; }
        public string LearnerLessonType { get; set; } = "";
        public int InstructorId { get; set; }
        public string? InstructorName { get; set; }
    }

    public class BookingResponseDto
    {
        public int BookingId { get; set; }
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public int InstructorId { get; set; }
        public string InstructorName { get; set; } = "";
        public DateTime LessonDate { get; set; }
        public TimeSpan LessonTime { get; set; }
        public string LessonType { get; set; } = "";
        public string BookingStatus { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public DateTime UpdatedAt { get; set; }
    }
}