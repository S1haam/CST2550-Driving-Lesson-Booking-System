@page "/book-time"
@rendermode InteractiveServer
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<h3>Select Time</h3>

<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/home")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/book")'>Book lessons</button>
    <button @onclick='() => Nav.NavigateTo("/faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/settings")'>Settings</button>
</div>

<div class="booking-card">

    <h1>Select a Time</h1>
    <p>Please select the available times:</p>

    <div class="booking-grid">

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("09:00-11:00")' />
            <span>9:00–11:00</span>
        </label>

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("11:00-13:00")' />
            <span>11:00–13:00</span>
        </label>

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("12:00-14:00")' />
            <span>12:00–14:00</span>
        </label>

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("13:00-15:00")' />
            <span>13:00–15:00</span>
        </label>

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("15:00-17:00")' />
            <span>15:00–17:00</span>
        </label>

        <label class="booking-box">
            <input type="radio" name="time" @onchange='() => SelectTime("17:00-19:00")' />
            <span>17:00–19:00</span>
        </label>

    </div>

    <button class="booking-back" @onclick="GoBack">
        Back
    </button>

    <button class="booking-btn" @onclick="GoToSummary">
        Next: summary selection
    </button>

</div>

@code {
    string? selectedTime;
    string? selectedDate;
    string? mode;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("date", out var dateValue))
        {
            selectedDate = dateValue;
        }

        if (query.TryGetValue("mode", out var modeValue))
        {
            mode = modeValue;
        }
    }

    void SelectTime(string time)
    {
        selectedTime = time;
    }

    void GoBack()
    {
        if (mode == "reschedule")
        {
            Nav.NavigateTo("/book?mode=reschedule");
        }
        else
        {
            Nav.NavigateTo("/book");
        }
    }

    void GoToSummary()
    {
        if (!string.IsNullOrEmpty(selectedTime))
        {
            if (mode == "reschedule")
            {
                Nav.NavigateTo($"/book-summary?date={selectedDate}&time={selectedTime}&mode=reschedule");
            }
            else
            {
                Nav.NavigateTo($"/book-summary?date={selectedDate}&time={selectedTime}");
            }
        }
    }
}