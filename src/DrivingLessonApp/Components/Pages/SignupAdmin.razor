@page "/signup-admin"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using System.Text.RegularExpressions

<div class="booking-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>Sign Up: Admin</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input type="email"
           placeholder="Admin Email"
           @bind="email" />

    <input type="password"
           placeholder="Password"
           @bind="password" />

    <input type="password"
           placeholder="Confirm Password"
           @bind="confirmPassword" />

    <button class="booking-btn"
            @onclick="RegisterAdmin"
            disabled="@isSubmitting">
        @(isSubmitting ? "Submitting..." : "Sign Up")
    </button>

    <button class="booking-back"
            @onclick='() => Nav.NavigateTo("/login?role=admin")'>
        Back
    </button>

</div>

@code {
    string? email;
    string? password;
    string? confirmPassword;
    string? errorMessage;
    bool isSubmitting;

    // this validates admin signup input and calls the backend
    async Task RegisterAdmin()
    {
        errorMessage = null;

        var cleanEmail = email?.Trim() ?? "";
        var cleanPassword = password?.Trim() ?? "";
        var cleanConfirmPassword = confirmPassword?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(cleanEmail) ||
            string.IsNullOrWhiteSpace(cleanPassword) ||
            string.IsNullOrWhiteSpace(cleanConfirmPassword))
        {
            errorMessage = "Please fill in all fields.";
            return;
        }

        if (!IsValidEmail(cleanEmail))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        if (!IsValidPassword(cleanPassword))
        {
            errorMessage = "Password must be at least 6 characters and include one uppercase letter and one number.";
            return;
        }

        if (cleanPassword != cleanConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        isSubmitting = true;

        var request = new RegisterAdminRequest
        {
            AdminEmail = cleanEmail,
            Password = cleanPassword
        };

        var response = await Http.PostAsJsonAsync("api/auth/register/admin", request);
        var result = await response.Content.ReadFromJsonAsync<ApiResponse<object>>();

        isSubmitting = false;

        if (!response.IsSuccessStatusCode || result == null || !result.Success)
        {
            errorMessage = result?.Message ?? "Could not create admin account.";
            return;
        }

        Nav.NavigateTo("/login?role=admin");
    }

    // this validates email format
    bool IsValidEmail(string value)
    {
        return new EmailAddressAttribute().IsValid(value) &&
               value.Contains("@") &&
               value.Contains(".") &&
               Regex.IsMatch(value, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    }

    // this validates password strength
    bool IsValidPassword(string value)
    {
        return value.Length >= 6 &&
               value.Any(char.IsUpper) &&
               value.Any(char.IsDigit);
    }

    public class RegisterAdminRequest
    {
        public string AdminEmail { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class ApiResponse<T>
    {
        public bool Success { get; set; }
        public string Message { get; set; } = "";
        public T? Data { get; set; }
    }
}