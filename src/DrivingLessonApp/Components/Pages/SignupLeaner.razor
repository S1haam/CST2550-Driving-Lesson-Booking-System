@page "/signup-learner"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject DrivingLessonApp.Services.LearnerSignupState SignupState

@using System.ComponentModel.DataAnnotations
@using System.Text.RegularExpressions

<div class="booking-card signup-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>Sign Up: Learner</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input class="signup-input" placeholder="Provisional Licence ID" @bind="licenceId" />
    <input class="signup-input" placeholder="Full Name" @bind="name" />
    <input class="signup-input" placeholder="Email Address" @bind="email" />
    <input class="signup-input" placeholder="Phone Number" @bind="phone" />
    <input class="signup-input" type="password" placeholder="Password" @bind="password" />
    <input class="signup-input" type="password" placeholder="Confirm Password" @bind="confirmPassword" />

    <button class="signup-btn" @onclick="RegisterUser">
        Sign Up
    </button>

    <button class="signup-back" @onclick='() => Nav.NavigateTo("/login?role=learner")'>
        Back
    </button>

</div>

@code {
    string licenceId = "";
    string name = "";
    string email = "";
    string phone = "";
    string password = "";
    string confirmPassword = "";
    string? errorMessage;

    // this validates learner signup input before moving to the next page
    void RegisterUser()
    {
        errorMessage = null;

        var cleanLicenceId = licenceId.Trim();
        var cleanName = name.Trim();
        var cleanEmail = email.Trim();
        var cleanPhone = phone.Trim();

        if (string.IsNullOrWhiteSpace(cleanLicenceId) ||
            string.IsNullOrWhiteSpace(cleanName) ||
            string.IsNullOrWhiteSpace(cleanEmail) ||
            string.IsNullOrWhiteSpace(cleanPhone) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        if (!IsValidEmail(cleanEmail))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        if (!IsValidPhone(cleanPhone))
        {
            errorMessage = "Phone number must be exactly 11 numbers.";
            return;
        }

        if (!IsValidPassword(password))
        {
            errorMessage = "Password must be at least 6 characters and include one uppercase letter and one number.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        SignupState.LicenceId = cleanLicenceId;
        SignupState.Name = cleanName;
        SignupState.Email = cleanEmail;
        SignupState.Phone = cleanPhone;
        SignupState.Password = password;
        SignupState.LessonType = "";
        SignupState.SelectedInstructorId = 0;

        Nav.NavigateTo("/choose-type");
    }

    // this validates email format
    bool IsValidEmail(string value)
    {
        return new EmailAddressAttribute().IsValid(value) &&
               value.Contains("@") &&
               value.Contains(".") &&
               Regex.IsMatch(value, @"^[^@\s]+@[^@\s]+\.[^@\s]+$");
    }

    // this validates password strength
    bool IsValidPassword(string value)
    {
        return value.Length >= 6 &&
               value.Any(char.IsUpper) &&
               value.Any(char.IsDigit);
    }

    // this validates phone number
    bool IsValidPhone(string value)
    {
        return Regex.IsMatch(value, @"^\d{11}$");
    }
}