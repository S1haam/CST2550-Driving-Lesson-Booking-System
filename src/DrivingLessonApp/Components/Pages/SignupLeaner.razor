@page "/signup-learner"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject DrivingLessonApp.Services.LearnerSignupState SignupState

<div class="booking-card signup-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>Sign Up: Learner</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <p style="color:red; margin-bottom:10px;">@errorMessage</p>
    }

    <input class="signup-input" placeholder="Provisional Licence ID" @bind="licenceId" />
    <input class="signup-input" placeholder="Full Name" @bind="name" />
    <input class="signup-input" placeholder="Email Address" @bind="email" />
    <input class="signup-input" placeholder="Phone Number" @bind="phone" />
    <input class="signup-input" type="password" placeholder="Password" @bind="password" />
    <input class="signup-input" type="password" placeholder="Confirm Password" @bind="confirmPassword" />

    <button class="signup-btn" @onclick="RegisterUser">
        Sign Up
    </button>

    <button class="signup-back" @onclick='() => Nav.NavigateTo("/login?role=learner")'>
        Back
    </button>

</div>

@code {
    string licenceId = "";
    string name = "";
    string email = "";
    string phone = "";
    string password = "";
    string confirmPassword = "";
    string? errorMessage;

    // this validates learner signup input before moving to the next page
    void RegisterUser()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(licenceId) ||
            string.IsNullOrWhiteSpace(name) ||
            string.IsNullOrWhiteSpace(email) ||
            string.IsNullOrWhiteSpace(phone) ||
            string.IsNullOrWhiteSpace(password) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            errorMessage = "Please fill in all required fields.";
            return;
        }

        if (!new System.ComponentModel.DataAnnotations.EmailAddressAttribute().IsValid(email.Trim()))
        {
            errorMessage = "Please enter a valid email address.";
            return;
        }

        if (password.Length < 6)
        {
            errorMessage = "Password must be at least 6 characters.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        SignupState.LicenceId = licenceId.Trim();
        SignupState.Name = name.Trim();
        SignupState.Email = email.Trim();
        SignupState.Phone = phone.Trim();
        SignupState.Password = password;
        SignupState.LessonType = "";
        SignupState.SelectedInstructorId = 0;

        Nav.NavigateTo("/choose-type");
    }
}