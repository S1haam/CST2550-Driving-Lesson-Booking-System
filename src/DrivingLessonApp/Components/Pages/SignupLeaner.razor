@page "/signup-learner"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="booking-card signup-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>Sign Up: Learner</h3>

    <!-- licence -->
    <input class="signup-input" placeholder="Provisional Licence ID" @bind="licenceId" />

    <!-- name -->
    <input class="signup-input" placeholder="Full Name" @bind="name" />

    <!-- email -->
    <input class="signup-input" placeholder="Email Address" @bind="email" />

    <!-- password -->
    <input class="signup-input" type="password" placeholder="Password" @bind="password" />

    <!-- confirm password -->
    <input class="signup-input" type="password" placeholder="Confirm Password" @bind="confirmPassword" />

    <!-- sign up -->
    <button class="signup-btn" @onclick="RegisterUser">
        Sign Up
    </button>

    <!-- back -->
    <button class="signup-back" @onclick='() => Nav.NavigateTo("/login?role=learner")'>
        Back
    </button>

</div>

@code {
    string licenceId;
    string name;
    string email;
    string password;
    string confirmPassword;

    // handles signup
    void RegisterUser()
    {
        // simple validation
        if (password != confirmPassword)
        {
            return;
        }

        // move to next step (auto/manual)
        Nav.NavigateTo("/choose-type");
    }
}