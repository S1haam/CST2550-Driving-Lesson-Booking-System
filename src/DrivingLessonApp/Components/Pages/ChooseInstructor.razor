@page "/choose-instructor"
@rendermode InteractiveServer
@inject NavigationManager Nav

<div class="booking-card instructor-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>
    <h3>You have a choice of instructors:</h3>

    <!-- instructor options -->
    <button class="instructor-btn @(selectedInstructor == 1 ? "selected" : "")"
            @onclick='() => SelectInstructor(1)'>
        Driver 1
    </button>

    <button class="instructor-btn @(selectedInstructor == 2 ? "selected" : "")"
            @onclick='() => SelectInstructor(2)'>
        Driver 2
    </button>

    <button class="instructor-btn @(selectedInstructor == 3 ? "selected" : "")"
            @onclick='() => SelectInstructor(3)'>
        Driver 3
    </button>

    <!-- navigation -->
    <div class="instructor-nav">

        <button class="instructor-back" @onclick='() => Nav.NavigateTo("/choose-type")'>
            Back
        </button>

        <button class="instructor-next"
                disabled="@(selectedInstructor == 0)"
                @onclick="Finish">
            Next
        </button>

    </div>

</div>

@code {
    int selectedInstructor = 0;

    // stores selected instructor
    void SelectInstructor(int id)
    {
        selectedInstructor = id;
    }

    // moves to home page
    void Finish()
    {
        if (selectedInstructor != 0)
        {
            Nav.NavigateTo("/home");
        }
    }
}