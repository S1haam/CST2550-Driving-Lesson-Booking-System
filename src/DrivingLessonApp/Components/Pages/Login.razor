@page "/login"
@rendermode InteractiveServer
@inject NavigationManager Nav

@using Microsoft.AspNetCore.WebUtilities

<div class="booking-card">

    <h1>WELCOME TO SER DRIVING SCHOOL</h1>

    <!-- email -->
    <input placeholder="Email" @bind="email" />

    <!-- password -->
    <input type="password" placeholder="Password" @bind="password" />

    <!-- login button -->
    <button class="booking-btn" @onclick="LoginUser">
        Login
    </button>

    <!-- create account -->
    <p class="link-text">
    Don't have an account?
    <span class="link-action" @onclick="GoToSignup">Create one</span>
</p>

</div>

@code {
    string email;
    string password;
    string role;

    // gets role from url
    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("role", out var value))
        {
            role = value;
        }
    }

    // handles login
    void LoginUser()
    {
        Nav.NavigateTo("/home");
    }

    // sends user to correct signup page
    void GoToSignup()
    {
        if (role == "learner")
        {
            Nav.NavigateTo("/signup-learner");
        }
        else if (role == "instructor")
        {
            Nav.NavigateTo("/signup-instructor");
        }
        else if (role == "admin")
        {
            Nav.NavigateTo("/signup-admin");
        }
        else
        {
            Nav.NavigateTo("/");
        }
    }
}
