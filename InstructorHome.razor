@page "/instructorHome"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<div class="brand-title">SER Driving School</div>

<h3>Instructor Home</h3>

<!-- NAV BAR -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<!-- MAIN PANEL -->
<div class="instructor-home-panel">

    <p class="welcome-text">Welcome Instructor,</p>

    <div class="notif-bar">
        <span>You have 2 new notifications</span>
        <button class="notif-btn"
                @onclick='() => Nav.NavigateTo("/instructor-inbox")'>
            Check Inbox
        </button>
    </div>

    <div class="status-row">
        <span class="status-dot"></span>
        <span>Active</span>
    </div>

    <div class="home-grid">

        <!-- UPCOMING LESSONS -->
        <div class="home-card">
            <div class="card-title">Upcoming lessons</div>

            @foreach (var instructorLesson in instructorLessons)
            {
                <div class="pill-row">
                    <span>@instructorLesson.DisplayText</span>
                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-lesson-details?id={instructorLesson.Id}&type=next")'>
                        View
                    </button>
                </div>
            }
        </div>

        <!-- STUDENTS -->
        <div class="home-card">
            <div class="student-header-row">
    <div class="card-title student-card-title">Students</div>

    <div class="search-container student-search-container">
        <input @bind="instructorStudentSearch"
               placeholder="Search by ID" />
        <button type="button">Search</button>
    </div>
</div>

            @{
                var filteredInstructorStudents = FilteredInstructorStudents();
            }

            @foreach (var instructorStudent in filteredInstructorStudents)
            {
                <div class="pill-row">
                    <div class="student-left">
                        <div class="avatar-circle">@instructorStudent.Initials</div>
                        <span>@instructorStudent.Name</span>
                    </div>

                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-student?id={instructorStudent.Id}")'>
                        View
                    </button>
                </div>
            }

            @if (!filteredInstructorStudents.Any())
            {
                <p>No students found.</p>
            }

        </div>

    </div>

</div>

@code {
    int InstructorId = 1;

    int NotificationCount = 0;
    List<LessonDto>? UpcomingLessons;
    List<StudentDto>? InstructorStudents;

    string StudentSearch = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        await LoadLessons();
        await LoadStudents();
    }

    async Task LoadNotifications()
    {
        var notifications = await Http.GetFromJsonAsync<List<Notification>>(
            $"/api/Instructor/{InstructorId}/notifications"
        );

        NotificationCount = notifications?.Count(n => !n.IsRead) ?? 0;
    }

    async Task LoadLessons()
    {
        UpcomingLessons = await Http.GetFromJsonAsync<List<LessonDto>>(
            $"/api/Instructor/{InstructorId}/bookings"
        );
    }

    async Task LoadStudents()
    {
        InstructorStudents = await Http.GetFromJsonAsync<List<StudentDto>>(
            $"/api/Instructor/learners?name={StudentSearch}&email="
        );
    }

    IEnumerable<StudentDto> FilteredInstructorStudents =>
        InstructorStudents?
            .Where(s =>
                s.Name.Contains(StudentSearch, StringComparison.OrdinalIgnoreCase)
            )
        ?? Enumerable.Empty<StudentDto>();

    class LessonDto
    {
        public int Id { get; set; }
        public string DisplayText { get; set; } = "";
    }

    class StudentDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Initials => string.Join("", Name.Split(' ').Select(n => n[0]));
    }
}
