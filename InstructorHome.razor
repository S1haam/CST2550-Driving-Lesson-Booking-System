@page "/instructorHome"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<div class="brand-title">SER Driving School</div>

<h3>Instructor Home</h3>

<!-- NAV BAR -->
<div class="nav-bar">
    <button @onclick='() => Nav.NavigateTo("/instructorHome")'>Home</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-schedule")'>My Schedule</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-inbox")'>Inbox</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-faqs")'>FAQs</button>
    <button @onclick='() => Nav.NavigateTo("/instructor-settings")'>Settings</button>
</div>

<!-- MAIN PANEL -->
<div class="instructor-home-panel">

    <p class="welcome-text">Welcome Instructor,</p>

    <div class="notif-bar">
        <span>You have @NotificationCount new notifications</span>
        <button class="notif-btn"
                @onclick='() => Nav.NavigateTo("/instructor-inbox")'>
            Check Inbox
        </button>
    </div>

    <div class="status-row">
        <span class="status-dot"></span>
        <span>Active</span>
    </div>

    <div class="home-grid">

        <!-- UPCOMING LESSONS -->
        <div class="home-card">
            <div class="card-title">Upcoming lessons</div>

            @foreach (var lesson in UpcomingLessons ?? new List<LessonDto>())
            {
                <div class="pill-row">
                    <span>@lesson.DisplayText</span>
                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-lesson-details?id={lesson.Id}&type=next")'>
                        View
                    </button>
                </div>
            }
        </div>

        <!-- LEARNERS -->
        <div class="home-card">
            <div class="student-header-row">
                <div class="card-title student-card-title">Learners</div>

                <div class="search-container student-search-container">
                    <input @bind="LearnerSearch"
                           placeholder="Search by name" />
                    <button type="button">Search</button>
                </div>
            </div>

            @{
                var filteredLearners = FilteredLearners();
            }

            @foreach (var learner in filteredLearners)
            {
                <div class="pill-row">
                    <div class="student-left">
                        <div class="avatar-circle">@learner.Initials</div>
                        <span>@learner.LearnerName</span>
                    </div>

                    <button class="pill-btn"
                            @onclick='() => Nav.NavigateTo($"/instructor-learner/{learner.LearnerId}")'>
                        View
                    </button>
                </div>
            }

            @if (!filteredLearners.Any())
            {
                <p>No learners found.</p>
            }

        </div>

    </div>

</div>

@code {
    int InstructorId = 1;

    int NotificationCount = 0;
    List<LessonDto>? UpcomingLessons;
    List<LearnerDto>? InstructorLearners;

    string LearnerSearch = "";

    protected override async Task OnInitializedAsync()
    {
        await LoadNotifications();
        await LoadLessons();
        await LoadLearners();
    }

    async Task LoadNotifications()
    {
        var notifications = await Http.GetFromJsonAsync<List<Notification>>(
            $"/api/Instructor/{InstructorId}/notifications"
        );

        NotificationCount = notifications?.Count(n => !n.IsRead) ?? 0;
    }

    async Task LoadLessons()
    {
        UpcomingLessons = await Http.GetFromJsonAsync<List<LessonDto>>(
            $"/api/Instructor/{InstructorId}/bookings"
        );
    }

    async Task LoadLearners()
    {
        InstructorLearners = await Http.GetFromJsonAsync<List<LearnerDto>>(
            $"/api/Instructor/learners?name={LearnerSearch}&email="
        );
    }

    IEnumerable<LearnerDto> FilteredLearners() =>
        InstructorLearners?
            .Where(l =>
                l.LearnerName.Contains(LearnerSearch, StringComparison.OrdinalIgnoreCase)
            )
        ?? Enumerable.Empty<LearnerDto>();

    class LessonDto
    {
        public int Id { get; set; }
        public string DisplayText { get; set; } = "";
    }

    class LearnerDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string Initials => string.Join("", LearnerName.Split(' ').Select(n => n[0]));
    }
}
