@page "/instructor-request/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<div class="brand-title">SER Driving School</div>

@if (Notification == null)
{
    <p>Loading...</p>
}
else 
{
<h3>Booking Request</h3>

<div class="instructor-message-card">

    <h3>@Notification.NotificationType</h3>
    <p>@Notification.Message </p>
    <p>@Notification.CreatedAt</p>

    <div class="instructor-confirm-actions">

        <button class="instructor-success-btn"
                @onclick='() => Nav.NavigateTo($"/instructor-confirm-yes/{id}")'>
            Yes
        </button>

        <button class="instructor-danger-btn"
                @onclick='() => Nav.NavigateTo($"/instructor-confirm-no/{id}")'>
            No
        </button>

    </div>

 </div>
 }

@code {
    [Parameter] public int id { get; set; }
    Notification? Notification;

    protected override async Task OnInitializedAsync()
    {
        Notification = await Http.GetFromJsonAsync<Notification>(
            $"/api/Instructor/notification/{id}"
        );
    }
}
