@page "/instructor-remove-confirm/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<div class="brand-title">SER Driving School</div>

<h3>Confirm Removal</h3>

@if (learner == null)
{
    <p>Loading...</p>
}
else
{
<div class="instructor-student-card">

    <h2>@learner.LearnerName</h2>

    <p>
        Are you sure you want to remove this Learner?
    </p>

    <div class="instructor-confirm-actions">

        <button class="instructor-success-btn"
                @onclick="RemoveLearner">
            Yes
        </button>

        <button class="instructor-danger-btn"
                @onclick='() => Nav.NavigateTo($"/instructor-not-removed/{id}")'>
            No
        </button>

    </div>
</div>
}

@code {
    [Parameter] public int id { get; set; }

    LearnerDto? learner;

    protected override async Task OnInitializedAsync()
    {
        learner = await Http.GetFromJsonAsync<LearnerDto>(
            $"/api/Instructor/learner/{id}"
        );
    }

    async Task RemoveLearner()
    {
        var response = await Http.DeleteAsync($"/api/Instructor/learner/{id}");
        if (response.IsSuccessStatusCode)
        {
            Nav.NavigateTo($"/instructor-removed/{id}");
        }
        else
        {
            Nav.NavigateTo($"/instructor-not-removed/{id}");
        }
    }

    class LearnerDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string LearnerPhone { get; set; } = "";
        public string LearnerEmail { get; set; } = "";
        public string LearnerStatus { get; set; } = "";
    }
}
