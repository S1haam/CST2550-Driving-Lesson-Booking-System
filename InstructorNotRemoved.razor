@page "/instructor-not-removed/{id:int}"
@rendermode InteractiveServer
@inject NavigationManager Nav
@inject HttpClient Http

<div class="brand-title">SER Driving School</div>

<h3>Action Cancelled</h3>

@if (learner == null)
{
    <p>Loading...</p>
}
else 
{

<div class="instructor-student-card">

    <h2>@learner.LearnerName</h2>

    <p>
        @learner.LearnerName was NOT removed from your list.
    </p>

    <button class="booking-btn"
            @onclick='() => Nav.NavigateTo("/instructorHome")'>
        Back to Home
    </button>

</div>
}

@code {
    [Parameter] public int id { get; set; }
    LearnerDto? learner;

    protected override async Task OnInitializedAsync()
    {
        learner = await Http.GetFromJsonAsync<LearnerDto>(
            $"/api/Instructor/learner/{id}"
        );
    }

    class LearnerDto
    {
        public int LearnerId { get; set; }
        public string LearnerName { get; set; } = "";
        public string LearnerPhone { get; set; } = "";
        public string LearnerEmail { get; set; } = "";
        public string LearnerStatus { get; set; } = "";
    }
}
