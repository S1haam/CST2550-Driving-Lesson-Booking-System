@page "/admin/student/{id}"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3>Student Profile</h3>

    
    <div class="nav-bar">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/")'>Log out</button>
    </div>

    
    <div class="outer-card">
        <div class="inner-card">

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Student Information:
            </div>

            <p><strong>Name:</strong> @Student.Name</p>
            <p><strong>Email:</strong> @Student.Email</p>
            <p><strong>Phone Number:</strong> @Student.Phone</p>
            <p><strong>Account Status:</strong> @Student.Status</p>

            <br />

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Lesson Details:
            </div>

            <p><strong>Lessons Booked:</strong> @Student.LessonsBooked</p>
            <p><strong>Date of last lesson:</strong> @Student.LastLesson</p>
            <p><strong>Date of next lesson:</strong> @Student.NextLesson</p>
            <p><strong>Lesson Instructor:</strong> @Student.InstructorName</p>

            <br />

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Additional Details:
            </div>

            <p><strong>Joined on:</strong> @Student.JoinedOn</p>
            <p><strong>Last login:</strong> @Student.LastLogin</p>

        </div>
    </div>

    
    <div style="text-align:center; margin-top:20px;">
        <button class="tab" @onclick='() => Nav.NavigateTo("/admin/students")'>
            Back to Student Database
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string id { get; set; }

 
    public class StudentProfile
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Status { get; set; } = "";
        public int LessonsBooked { get; set; }
        public string LastLesson { get; set; } = "";
        public string NextLesson { get; set; } = "";
        public string InstructorName { get; set; } = "";
        public string JoinedOn { get; set; } = "";
        public string LastLogin { get; set; } = "";
    }

    // sample data — ill replace with real data later
    public StudentProfile Student { get; set; } = new StudentProfile
    {
        Name = "Olive Smith",
        Email = "o@gmail.com",
        Phone = "07123456789",
        Status = "Active",
        LessonsBooked = 3,
        LastLesson = "01/01/2026",
        NextLesson = "07/01/2026",
        InstructorName = "Kat Valentine",
        JoinedOn = "13/11/2025",
        LastLogin = "30/12/2025"
    };
}
