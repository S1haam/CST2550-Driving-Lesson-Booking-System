@page "/admin"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3 style="text-align:center; margin-bottom:25px;">Welcome, Admin</h3>

    <!-- Button Grid -->
    <div class="admin-grid">

        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>
            View: Student database
        </button>

        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/system")'>
            View: System Activity
        </button>

        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>
            View: Instructor database
        </button>

        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/profile")'>
            View: Admin Profile
        </button>

        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/settings")'>
            Settings
        </button>

    </div>
</div>