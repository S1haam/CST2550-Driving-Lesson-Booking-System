@page "/admin/profile"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3>Admin Profile</h3>

    
    <div class="nav-bar">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/")'>Log out</button>
    </div>

    <div class="outer-card">
        <div class="inner-card">

          
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Account Information:
            </div>

            <p><strong>Name:</strong> @Admin.Name</p>
            <p><strong>Email:</strong> @Admin.Email</p>
            <p><strong>Phone Number:</strong> @Admin.Phone</p>
            <p><strong>Account Status:</strong> @Admin.Status</p>

            <br />

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Security Settings:
            </div>

            <p><strong>Last password change:</strong> @Admin.LastPasswordChange</p>
            <p><strong>Login History:</strong> View Activity</p>

            <br />

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Additional Actions:
            </div>

            <p>Change password</p>
            <p>Update Email</p>

        </div>
    </div>

   
    <div style="text-align:center; margin-top:20px;">
        <button class="tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    
    public class AdminProfileModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Status { get; set; } = "";
        public string LastPasswordChange { get; set; } = "";
    }

    //  sample data — ill replace w real data later
    public AdminProfileModel Admin { get; set; } = new AdminProfileModel
    {
        Name = "Admin User",
        Email = "a@gmail.com",
        Phone = "07345678912",
        Status = "Active",
        LastPasswordChange = "05/10/2025"
    };
}