@page "/admin/student-activity/{id}"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3>Student Activity</h3>

    
    <div class="nav-bar">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/")'>Log out</button>
    </div>

    
    <div class="outer-card">
        <div class="inner-card">

            
            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Student Summary:
            </div>

            <p><strong>Name:</strong> @Student.Name</p>
            <p><strong>Email:</strong> @Student.Email</p>
            <p><strong>Phone Number:</strong> @Student.Phone</p>
            <p><strong>Lessons Booked:</strong> @Student.LessonsBooked</p>

            <br />

            <div class="section-label" style="color:#2d4ea2; font-weight:bold; margin-bottom:10px;">
                Activity Timeline:
            </div>

            @foreach (var entry in Student.ActivityTimeline)
            {
                <p>@entry</p>
            }

        </div>
    </div>

  
    <div style="text-align:center; margin-top:20px;">
        <button class="tab" @onclick='() => Nav.NavigateTo("/admin")'>
            Back to Home
        </button>
    </div>
</div>

@code {
    [Parameter]
    public string id { get; set; }

   
    public class StudentActivityModel
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public int LessonsBooked { get; set; }
        public List<string> ActivityTimeline { get; set; } = new();
    }

    // sample data — ill replace w real data later
    public StudentActivityModel Student { get; set; } = new StudentActivityModel
    {
        Name = "John Smith",
        Email = "j@gmail.com",
        Phone = "07123456789",
        LessonsBooked = 5,
        ActivityTimeline = new List<string>
        {
            "03/03/2025 - Account created",
            "05/03/2025 - Logged in",
            "09/03/2025 - Booked lesson",
            "10/03/2025 - Lesson completed"
        }
    };
}