@page "/admin/instructors"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3>Instructor Database</h3>

    <div class="nav-bar">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/")'>Log out</button>
    </div>

    <div class="outer-card">
        <div class="inner-card">

            <table class="student-table">
                <thead>
                    <tr>
                        <th>Instructor ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Availability</th>
                        <th>Profile</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var i in Instructors)
                    {
                        <tr>
                            <td>@i.InstructorId</td>
                            <td>@i.Name</td>
                            <td>@i.Email</td>
                            <td>@i.Phone</td>
                            <td>@i.Availability</td>
                            <td>
                                <button class="view-btn" @onclick='() => ViewProfile(i.InstructorId)'>
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <div style="text-align:center; margin-top:20px;">
        <button class="tab" @onclick='() => Nav.NavigateTo("/admin")'>Back to Home</button>
    </div>
</div>

@code {
    public List<Instructor> Instructors { get; set; } = new()
    {
        new Instructor { InstructorId = "001", Name = "Jack", Email = "j@gmail.com", Phone = "07123", Availability = "Available" },
        new Instructor { InstructorId = "002", Name = "Beth", Email = "b@gmail.com", Phone = "07456", Availability = "Unavailable" },
        new Instructor { InstructorId = "003", Name = "Lola", Email = "l@gmail.com", Phone = "07789", Availability = "Available" }
    };

    public class Instructor
    {
        public string InstructorId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Availability { get; set; } = "";
    }

    void ViewProfile(string id)
    {
        Nav.NavigateTo($"/admin/instructor/{id}");
    }
}