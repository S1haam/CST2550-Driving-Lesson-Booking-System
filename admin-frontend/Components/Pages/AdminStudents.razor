@page "/admin/students"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3>Student Database</h3>

    <div class="nav-bar">
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin")'>Home</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/students")'>Students</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/admin/instructors")'>Instructors</button>
        <button class="action-btn" @onclick='() => Nav.NavigateTo("/")'>Log out</button>
    </div>

    <div class="outer-card">
        <div class="inner-card">

            <table class="student-table">
                <thead>
                    <tr>
                        <th>Student ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone Number</th>
                        <th>Lessons Booked</th>
                        <th>Profile</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var s in Students)
                    {
                        <tr>
                            <td>@s.StudentId</td>
                            <td>@s.Name</td>
                            <td>@s.Email</td>
                            <td>@s.Phone</td>
                            <td>@s.LessonsBooked</td>
                            <td>
                                <button class="view-btn" @onclick='() => ViewProfile(s.StudentId)'>
                                    View
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>

    <div style="text-align:center; margin-top:20px;">
        <button class="tab" @onclick='() => Nav.NavigateTo("/admin")'>Back to Home</button>
    </div>
</div>

@code {
    public List<Student> Students { get; set; } = new()
    {
        new Student { StudentId = "001", Name = "John", Email = "j@gmail.com", Phone = "07123", LessonsBooked = 2 },
        new Student { StudentId = "002", Name = "Olive", Email = "o@gmail.com", Phone = "07456", LessonsBooked = 3 },
        new Student { StudentId = "003", Name = "Kat", Email = "k@gmail.com", Phone = "07789", LessonsBooked = 1 }
    };

    public class Student
    {
        public string StudentId { get; set; } = "";
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public int LessonsBooked { get; set; }
    }

    void ViewProfile(string id)
    {
        Nav.NavigateTo($"/admin/student/{id}");
    }
}