@page "/admin/signup"
@inject NavigationManager Nav

<div class="main-content">
    <div class="brand-title">SER Driving School</div>

    <h3 style="text-align:center; margin-bottom:25px;">Admin Sign Up</h3>

    <div class="outer-card">
        <div class="inner-card">

            <div class="section-label">Create Account</div>

            <div class="auth-field">
                <label>Name:</label>
                <input name="AdminName" @bind="AdminName" />
            </div>

            <div class="auth-field">
                <label>Email:</label>
                <input name="AdminEmail" @bind="AdminEmail" />
            </div>

            <div class="auth-field">
                <label>Password:</label>
                <input name="AdminPassword" type="password" @bind="AdminPassword" />
            </div>

            <div class="auth-field">
                <label>Confirm Password:</label>
                <input name="ConfirmAdminPassword" type="password" @bind="ConfirmPassword" />
            </div>

            <button class="action-btn" style="width:100%; margin-top:20px;" @onclick="CreateAccount">
                Sign Up
            </button>

            <button class="action-btn" style="width:100%; margin-top:10px;" @onclick="GoBack">
                Back
            </button>

        </div>
    </div>
</div>

@code {
    public string AdminName { get; set; }
    public string AdminEmail { get; set; }
    public string AdminPassword { get; set; }
    public string ConfirmPassword { get; set; }

    void CreateAccount()
    {
        if (AdminPassword != ConfirmPassword)
            return;

        Nav.NavigateTo("/admin");
    }

    void GoBack()
    {
        Nav.NavigateTo("/admin/login");
    }
}